@using Client.Pages.Home
@inject UiStrings Strings

<div class="brain-map-row">
<div class="brain-map-diagram-scroll">
<div class="brain-map-diagram" style="width: @(DiagramWidth)px; height: @(DiagramHeight)px;">
    <span class="brain-map-center" style="left: @(CenterX)px; top: @(CenterY)px;">@Strings.Get("keywordsCenterLabel")</span>

    @foreach (var node in PositionedKeywords)
    {
        <div class="brain-map-node @NodeCssClass(node.Keyword, node.Index)" style="left: @(node.X)px; top: @(node.Y)px; --bubble-color: @BubbleColor(node.Keyword);" @key="node.Keyword">
            @if (ShowHistory && node.Keyword.Status == KeywordStatus.AiDeleted)
            {
                <span class="brain-map-tag brain-map-tag-deleted">@Strings.Get("keywordsDeletedTag")</span>
                <span class="brain-map-label brain-map-label-deleted">@node.Keyword.Text</span>
                @if (CanEdit)
                {
                    <button type="button" class="brain-map-undo" @onclick="() => Restore(node.Keyword)" aria-label="Restore keyword">↺ @Strings.Get("undo")</button>
                }
            }
            else if (ShowHistory && node.Keyword.Status == KeywordStatus.UserAdded)
            {
                <span class="brain-map-tag brain-map-tag-added">@Strings.Get("keywordsAddedTag")</span>
                <span class="brain-map-label-row">
                    <span class="brain-map-label brain-map-label-added">@node.Keyword.Text</span>
                    @if (CanEdit)
                    {
                        <button type="button" class="brain-map-remove" @onclick="() => Remove(node.Keyword)" aria-label="Remove keyword">×</button>
                    }
                </span>
            }
            else if (CanEdit)
            {
                <span class="brain-map-label-row">
                    @if (node.IsLeftSide)
                    {
                        <button type="button" class="brain-map-remove" @onclick="() => Remove(node.Keyword)" aria-label="Remove keyword">×</button>
                    }
                    <span class="brain-map-label">@node.Keyword.Text</span>
                    @if (!node.IsLeftSide)
                    {
                        <button type="button" class="brain-map-remove" @onclick="() => Remove(node.Keyword)" aria-label="Remove keyword">×</button>
                    }
                </span>
                @if (node.Keyword.Count is int editCount)
                {
                    <span class="brain-map-count" data-tooltip="@OccurrenceTooltip(node.Keyword)">@editCount</span>
                }
            }
            else
            {
                @if (node.Keyword.Count is int count && IsAboveCenter(node.AngleDegrees))
                {
                    <span class="brain-map-count" data-tooltip="@OccurrenceTooltip(node.Keyword)">@count</span>
                }
                <span class="brain-map-label">@node.Keyword.Text</span>
                @if (node.Keyword.Count is int belowCount && !IsAboveCenter(node.AngleDegrees))
                {
                    <span class="brain-map-count" data-tooltip="@OccurrenceTooltip(node.Keyword)">@belowCount</span>
                }
            }
        </div>
    }
</div>
</div>

<BrainMapKeywordList Keywords="Keywords" ShowHistory="ShowHistory" CanEdit="CanEdit" OnRemove="Remove" OnRestore="Restore" />
</div>

<div class="brain-map-footer">
    @if (!ReadOnly)
    {
        @if (!AlwaysEditable)
        {
            @if (!EditMode)
            {
                <button type="button" class="brain-map-add-link" @onclick="() => EditMode = true">+ <strong>@Strings.Get("edit")</strong></button>
            }
            else
            {
                @AddPanel
            }
        }
        else
        {
            @AddPanel
        }
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>

@code {
    // Bubbles have a real, roughly-fixed footprint (padding + border + the ~10rem label
    // max-width they wrap within) unlike the old plain-text labels, so ring radii are solved
    // from how many bubbles actually sit on each ring — same circumference-budget technique
    // BrainMapGraph.razor already uses. Larger keyword lists grow *more* rings rather than
    // just a wider pair of them, so every ring can sit closer to the center while its own
    // neighbors still keep the full circumference budget of space between them.
    //
    // Nodes round-robin across rings by index (i % RingCount) — adjacent keywords land on
    // different rings, spreading related/nearby list entries around the whole diagram instead
    // of banding them into concentric groups.
    private const int TargetNodesPerRing = 7;
    private const int BubbleCircumferenceBudget = 230;
    private const int MinRingRadius = 190;
    private const int RingGap = 95;
    private const int CanvasMargin = 90;
    private const double RadiusYRatio = 0.7;

    private int KeywordCount => VisibleKeywords.Count();
    private int RingCount => Math.Max(1, (int)Math.Ceiling(KeywordCount / (double)TargetNodesPerRing));

    private int[] RingNodeCounts
    {
        get
        {
            var ringCount = RingCount;
            var counts = new int[ringCount];
            for (var i = 0; i < KeywordCount; i++)
                counts[i % ringCount]++;
            return counts;
        }
    }

    // Radius per ring, innermost first — each one at least MinRingRadius, and at least
    // RingGap past the previous ring, but grown further still if that ring's own node count
    // needs more circumference than that to keep bubbles from touching each other.
    private int[] RingRadiiX
    {
        get
        {
            var counts = RingNodeCounts;
            var radii = new int[counts.Length];
            for (var r = 0; r < counts.Length; r++)
            {
                var minForRing = r == 0 ? MinRingRadius : radii[r - 1] + RingGap;
                radii[r] = RadiusFor(counts[r], minForRing);
            }
            return radii;
        }
    }

    private static int RadiusFor(int ringNodeCount, int minRadius) =>
        ringNodeCount <= 1 ? minRadius : Math.Max(minRadius, (int)Math.Ceiling(ringNodeCount * BubbleCircumferenceBudget / (2 * Math.PI)));

    private int OuterRadiusX => RingRadiiX is { Length: > 0 } radii ? radii[^1] : MinRingRadius;

    private int DiagramWidth => Math.Max(760, (OuterRadiusX + CanvasMargin) * 2);
    private int DiagramHeight => Math.Max(520, (int)(OuterRadiusX * RadiusYRatio + CanvasMargin) * 2);
    private int CenterX => DiagramWidth / 2;
    private int CenterY => DiagramHeight / 2;

    [Parameter, EditorRequired] public List<BrainMapKeyword> Keywords { get; set; } = [];
    [Parameter] public bool ShowHistory { get; set; }
    [Parameter] public bool AlwaysEditable { get; set; }
    // Fully suppresses the add/remove UI regardless of AlwaysEditable/EditMode — for a
    // non-owner viewer of a shared note's Brain Map, who can look but never touch.
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<BrainMapKeyword> OnRemove { get; set; }
    [Parameter] public EventCallback<BrainMapKeyword> OnRestore { get; set; }
    [Parameter] public EventCallback<string> OnAdd { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool EditMode { get; set; }
    private string CustomKeyword { get; set; } = "";

    private bool CanEdit => !ReadOnly && (EditMode || AlwaysEditable);

    private IEnumerable<BrainMapKeyword> VisibleKeywords =>
        ShowHistory ? Keywords : Keywords.Where(k => k.Status != KeywordStatus.AiDeleted);

    private IEnumerable<(BrainMapKeyword Keyword, double AngleDegrees, int LabelRadiusX, int LabelRadiusY, int X, int Y, bool IsLeftSide, int Index)> PositionedKeywords
    {
        get
        {
            var visible = VisibleKeywords.ToList();
            var count = visible.Count;
            var ringCount = RingCount;
            var radii = RingRadiiX;
            for (var i = 0; i < count; i++)
            {
                var angle = -90 + i * (360.0 / count);
                var radiusX = radii[i % ringCount];
                var radiusY = (int)(radiusX * RadiusYRatio);
                var (x, y) = PointAt(angle, radiusX, radiusY);
                yield return (visible[i], angle, radiusX, radiusY, x, y, x < CenterX, i);
            }
        }
    }

    // AiKept nodes get the frequency-ranked blue bubble treatment; UserAdded ones get the same
    // glass bubble shape/animation, just tinted green (matching its existing label/tag color)
    // since it has no frequency to rank by. AiDeleted keeps its plain, no-bubble look — it's on
    // its way out, not something to visually promote (see NodeCssClass).
    private Dictionary<BrainMapKeyword, string> BubbleColors => BrainMapKeywordActions.ComputeBubbleColors(VisibleKeywords);

    private string BubbleColor(BrainMapKeyword keyword) => keyword.Status switch
    {
        KeywordStatus.UserAdded => "rgba(22, 163, 74, 0.35)",
        _ => BubbleColors.GetValueOrDefault(keyword, "transparent"),
    };

    private const int BubbleDelayClassCount = 4;

    // Keeps the count on the outer side of the label, away from the center hub, instead of
    // always sitting above it regardless of where the node actually falls on the ring.
    private static bool IsAboveCenter(double angleDegrees) => Math.Sin(angleDegrees * Math.PI / 180) < 0;

    private static string OccurrenceTooltip(BrainMapKeyword keyword) =>
        $"Found {keyword.Count} occurrence{(keyword.Count == 1 ? "" : "s")} of \"{keyword.Text}\" in the files.";

    private (int X, int Y) PointAt(double angleDegrees, int radiusX, int radiusY)
    {
        var angleRadians = angleDegrees * Math.PI / 180;
        return (CenterX + (int)(radiusX * Math.Cos(angleRadians)), CenterY + (int)(radiusY * Math.Sin(angleRadians)));
    }

    // Bubble glass/color treatment is reserved for AiKept nodes (they're the ones with a real
    // frequency rank to color by) — AiDeleted/UserAdded keep today's plain tagged-text look.
    private string NodeCssClass(BrainMapKeyword keyword, int index)
    {
        if (keyword.Status == KeywordStatus.AiDeleted)
            return !ShowHistory ? "" : "brain-map-node-deleted";

        var bubbleClasses = $"brain-map-bubble brain-map-bubble-delay-{index % BubbleDelayClassCount}";
        return ShowHistory && keyword.Status == KeywordStatus.UserAdded
            ? $"{bubbleClasses} brain-map-node-added"
            : bubbleClasses;
    }

    private RenderFragment AddPanel => @<div class="brain-map-add-panel">
        @if (!AlwaysEditable)
        {
            <button type="button" class="modal-close" @onclick="() => EditMode = false" aria-label="Close">&times;</button>
        }
        <h3 class="modal-form-heading">@Strings.Get("addMoreTopics")</h3>

        <input class="brain-map-suggestion brain-map-add-input" placeholder="@Strings.Get("addKeywordPlaceholder")"
               @bind="CustomKeyword" @bind:event="oninput" @onkeydown="HandleCustomKeydown" />
    </div>;

    private async Task Remove(BrainMapKeyword keyword) => await OnRemove.InvokeAsync(keyword);

    private async Task Restore(BrainMapKeyword keyword) => await OnRestore.InvokeAsync(keyword);

    private async Task HandleCustomKeydown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(CustomKeyword))
            return;

        await OnAdd.InvokeAsync(CustomKeyword.Trim());
        CustomKeyword = "";
    }
}
