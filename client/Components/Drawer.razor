@using Client.Services
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject TourState TourState
@inject UiStrings Strings

<nav class="drawer">
    <p class="drawer-greeting">Hello, @UserName</p>

    <div class="drawer-section">
        @if (AuthState.IsAdmin)
        {
            @if (Matches(Strings.Get("chatWithAi")))
            {
                <NavLink class="drawer-item" href="/chat">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("chatWithAi")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("allUsers")))
            {
                <NavLink class="drawer-item" href="/users">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("allUsers")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("requests")))
            {
                <NavLink class="drawer-item" href="/requests">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22 6 12 13 2 6" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("requests")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("dashboard")))
            {
                <NavLink class="drawer-item" href="/dashboard">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" />
                            <rect x="14" y="3" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" />
                            <rect x="3" y="14" width="7" height="7" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("dashboard")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("home")))
            {
                <NavLink class="drawer-item" href="/home" Match="NavLinkMatch.All">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("home")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("profilePage")))
            {
                <NavLink class="drawer-item" href="/profile">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("profilePage")</span>
                </NavLink>
            }
        }
        else
        {
            @if (Matches(Strings.Get("createNewNote")))
            {
                <button type="button" class="drawer-item @(IsOnCreateNotePage ? "active" : "")" data-tour="drawer-create-note" @onclick="GoToCreateNote">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("createNewNote")</span>
                </button>
            }

            @if (Matches(Strings.Get("allNotes")))
            {
                <NavLink class="drawer-item" href="/notes">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("allNotes")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("favorites")))
            {
                <NavLink class="drawer-item" href="/favorites">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("favorites")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("profilePage")))
            {
                <NavLink class="drawer-item" href="/profile">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("profilePage")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("connections")))
            {
                <NavLink class="drawer-item" href="/connections">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="7.5" cy="15.5" r="5.5" />
                            <path d="M21 2L11.4 11.6" />
                            <path d="M15.5 7.5l3 3L22 7l-3-3" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("connections")</span>
                </NavLink>
            }

            @if (Matches(Strings.Get("myRequests")))
            {
                <NavLink class="drawer-item" href="/my-requests">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6" />
                            <line x1="8" y1="12" x2="21" y2="12" />
                            <line x1="8" y1="18" x2="21" y2="18" />
                            <line x1="3" y1="6" x2="3.01" y2="6" />
                            <line x1="3" y1="12" x2="3.01" y2="12" />
                            <line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("myRequests")</span>
                </NavLink>
            }

            @if (AuthState.IsModerator)
            {
                @if (Matches(Strings.Get("chatWithAi")))
                {
                    <NavLink class="drawer-item" href="/chat">
                        <span class="drawer-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                            </svg>
                        </span>
                        <span class="drawer-label">@Strings.Get("chatWithAi")</span>
                    </NavLink>
                }

                @if (Matches(Strings.Get("allUsers")))
                {
                    <NavLink class="drawer-item" href="/users">
                        <span class="drawer-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                        </span>
                        <span class="drawer-label">@Strings.Get("allUsers")</span>
                    </NavLink>
                }

                @if (Matches(Strings.Get("requests")))
                {
                    <NavLink class="drawer-item" href="/requests">
                        <span class="drawer-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                <polyline points="22 6 12 13 2 6" />
                            </svg>
                        </span>
                        <span class="drawer-label">@Strings.Get("requests")</span>
                    </NavLink>
                }

                @if (Matches(Strings.Get("dashboard")))
                {
                    <NavLink class="drawer-item" href="/dashboard">
                        <span class="drawer-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" />
                                <rect x="14" y="3" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" />
                                <rect x="3" y="14" width="7" height="7" />
                            </svg>
                        </span>
                        <span class="drawer-label">@Strings.Get("dashboard")</span>
                    </NavLink>
                }
            }

            @if (Matches(Strings.Get("home")))
            {
                <NavLink class="drawer-item" href="/home" Match="NavLinkMatch.All">
                    <span class="drawer-icon">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                    </span>
                    <span class="drawer-label">@Strings.Get("home")</span>
                </NavLink>
            }

            @if (SearchTerm.Length > 0 && !AnyMatch)
            {
                <p class="drawer-no-match">@Strings.Get("noScreensFound")</p>
            }
        }
    </div>

    <div class="drawer-search">
        <SearchBar Placeholder="@Strings.Get("searchInMenu")" @bind-Value="SearchTerm" />
    </div>

    <div class="drawer-bottom">
        <NavLink class="drawer-item drawer-user" href="/profile">
            <span class="avatar-circle" aria-hidden="true">@UserName.Substring(0, 1)</span>
            <span class="drawer-label">@UserEmail</span>
        </NavLink>

        <NavLink class="drawer-item" href="/settings">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </span>
            <span class="drawer-label">@Strings.Get("settings")</span>
        </NavLink>

        <button type="button" class="drawer-item" data-tour="drawer-learn-synapse" @onclick="StartMainTutorial">
            <span class="drawer-icon drawer-icon-learn">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </span>
            <span class="drawer-label">@Strings.Get("learnSynapse")</span>
        </button>

        <button type="button" class="drawer-item drawer-logout" @onclick="HandleLogout">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </span>
            <span class="drawer-label">@Strings.Get("logOut")</span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public string UserName { get; set; } = "there";
    [Parameter] public string UserEmail { get; set; } = "";

    // Filters the top nav section only — Settings/Learn Synapse/Log Out in the bottom bar are
    // persistent utility actions, not "screens" in the sense this search is meant to find.
    private string SearchTerm { get; set; } = "";

    private bool Matches(string label) =>
        SearchTerm.Length == 0 || label.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase);

    // All possible non-admin item labels, used only to detect "search matched nothing" without
    // duplicating the whole role-branch logic above.
    private static readonly string[] NonAdminLabelKeys =
    [
        "createNewNote", "allNotes", "favorites", "profilePage", "connections", "myRequests",
        "chatWithAi", "allUsers", "requests", "dashboard", "home",
    ];

    private bool AnyMatch => NonAdminLabelKeys.Any(key => Matches(Strings.Get(key)));

    private bool IsOnCreateNotePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("notes/new");

    // A plain button, not a NavLink: navigating to "/notes/new" while already sitting on it
    // (e.g. right after finishing a note) is a same-URI Blazor navigation, which the router
    // treats as a no-op and never re-runs CreateNote.razor's OnInitialized — so the page would
    // stay stuck showing the just-finished note. ForceLoad only in that exact case reloads the
    // app fresh (Draft included); a normal SPA navigation is used from every other page.
    private void GoToCreateNote()
    {
        Navigation.NavigateTo("/notes/new", forceLoad: IsOnCreateNotePage);
    }

    // "Learn Synapse." always replays the main (Home) tour, regardless of whether it's been
    // seen before — RequestReplay both flags it for Home's TourGuide to pick up on mount (if
    // navigating in from elsewhere) and fires live (if TourGuide is already mounted, i.e. this
    // was clicked while already on Home).
    private void StartMainTutorial()
    {
        TourState.RequestReplay("home");
        if (Navigation.ToBaseRelativePath(Navigation.Uri) != "home")
            Navigation.NavigateTo("/home");
    }

    // ClearSessionAsync actually drops the stored token — just navigating to "/" left the old
    // (possibly expired) token sitting in localStorage, so a "logged out" user was still
    // silently authenticated as soon as they signed back in via the same tab.
    private async Task HandleLogout()
    {
        await AuthState.ClearSessionAsync();
        Navigation.NavigateTo("/");
    }
}
