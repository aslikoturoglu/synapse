@using Client.Services
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject UiStrings Strings

<nav class="drawer">
    <p class="drawer-greeting">Hello, @UserName</p>

    <div class="drawer-section">
        @if (AuthState.IsAdmin)
        {
            <NavLink class="drawer-item" href="/chat">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("chatWithAi")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/users">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("allUsers")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/dashboard">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("dashboard")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/home" Match="NavLinkMatch.All">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("home")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/profile">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("profilePage")</span>
            </NavLink>
        }
        else
        {
            <button type="button" class="drawer-item @(IsOnCreateNotePage ? "active" : "")" @onclick="GoToCreateNote">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("createNewNote")</span>
            </button>

            <NavLink class="drawer-item" href="/notes">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("allNotes")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/favorites">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("favorites")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/profile">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("profilePage")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/connections">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="7.5" cy="15.5" r="5.5" />
                        <path d="M21 2L11.4 11.6" />
                        <path d="M15.5 7.5l3 3L22 7l-3-3" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("connections")</span>
            </NavLink>

            <NavLink class="drawer-item" href="/home" Match="NavLinkMatch.All">
                <span class="drawer-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </span>
                <span class="drawer-label">@Strings.Get("home")</span>
            </NavLink>
        }
    </div>

    <div class="drawer-search">
        <SearchBar Placeholder="@Strings.Get("searchInMenu")" />
    </div>

    <div class="drawer-bottom">
        <NavLink class="drawer-item drawer-user" href="/profile">
            <span class="avatar-circle" aria-hidden="true">@UserName.Substring(0, 1)</span>
            <span class="drawer-label">@UserEmail</span>
        </NavLink>

        <NavLink class="drawer-item" href="/settings">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </span>
            <span class="drawer-label">@Strings.Get("settings")</span>
        </NavLink>

        <button type="button" class="drawer-item drawer-logout" @onclick="HandleLogout">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </span>
            <span class="drawer-label">@Strings.Get("logOut")</span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public string UserName { get; set; } = "there";
    [Parameter] public string UserEmail { get; set; } = "";

    private bool IsOnCreateNotePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("notes/new");

    // A plain button, not a NavLink: navigating to "/notes/new" while already sitting on it
    // (e.g. right after finishing a note) is a same-URI Blazor navigation, which the router
    // treats as a no-op and never re-runs CreateNote.razor's OnInitialized — so the page would
    // stay stuck showing the just-finished note. ForceLoad only in that exact case reloads the
    // app fresh (Draft included); a normal SPA navigation is used from every other page.
    private void GoToCreateNote()
    {
        Navigation.NavigateTo("/notes/new", forceLoad: IsOnCreateNotePage);
    }

    // ClearSessionAsync actually drops the stored token — just navigating to "/" left the old
    // (possibly expired) token sitting in localStorage, so a "logged out" user was still
    // silently authenticated as soon as they signed back in via the same tab.
    private async Task HandleLogout()
    {
        await AuthState.ClearSessionAsync();
        Navigation.NavigateTo("/");
    }
}
