@inject NavigationManager Navigation

<nav class="drawer">
    <p class="drawer-greeting">Hello, @UserName</p>

    <div class="drawer-section">
        <NavLink class="drawer-item" href="/notes/new">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
            </span>
            <span class="drawer-label">Create New Note</span>
        </NavLink>

        <NavLink class="drawer-item" href="/notes">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                </svg>
            </span>
            <span class="drawer-label">All Notes</span>
        </NavLink>

        <ul class="drawer-sublist">
            @foreach (var note in MockNoteTitles)
            {
                <li>
                    <NavLink class="drawer-subitem" href="/notes">
                        <span class="drawer-subicon" aria-hidden="true">↳</span>
                        <span class="drawer-label">@note</span>
                    </NavLink>
                </li>
            }
        </ul>

        <NavLink class="drawer-item" href="/favorites">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
            </span>
            <span class="drawer-label">Favorites</span>
        </NavLink>

        <NavLink class="drawer-item" href="/profile">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </span>
            <span class="drawer-label">Profile Page</span>
        </NavLink>

        <NavLink class="drawer-item" href="/connections">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7.5" cy="15.5" r="5.5" />
                    <path d="M21 2L11.4 11.6" />
                    <path d="M15.5 7.5l3 3L22 7l-3-3" />
                </svg>
            </span>
            <span class="drawer-label">Connections</span>
        </NavLink>

        <NavLink class="drawer-item" href="/home" Match="NavLinkMatch.All">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
            </span>
            <span class="drawer-label">Home</span>
        </NavLink>
    </div>

    <div class="drawer-search">
        <SearchBar Placeholder="Search in menu..." />
    </div>

    <div class="drawer-bottom">
        <NavLink class="drawer-item drawer-user" href="/profile">
            <span class="avatar-circle" aria-hidden="true">@UserName.Substring(0, 1)</span>
            <span class="drawer-label">@UserEmail</span>
        </NavLink>

        <NavLink class="drawer-item" href="/settings">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </span>
            <span class="drawer-label">Settings</span>
        </NavLink>

        <button type="button" class="drawer-item drawer-logout" @onclick="HandleLogout">
            <span class="drawer-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </span>
            <span class="drawer-label">Log Out</span>
        </button>
    </div>
</nav>

@code {
    [Parameter] public string UserName { get; set; } = "there";
    [Parameter] public string UserEmail { get; set; } = "";

    private static readonly string[] MockNoteTitles =
    [
        "Week 7 - Harm Principle",
        "Graph Algorithms Summary",
        "Midterm Review",
        "Lecture 3 - Utilitarianism",
        "Lab Notes - Sorting",
    ];

    private void HandleLogout()
    {
        Navigation.NavigateTo("/");
    }
}
