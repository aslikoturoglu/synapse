@inject UiStrings Strings

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <button type="button" class="modal-close" @onclick="Close" aria-label="Close">&times;</button>

            <div class="modal-body">
                @ChildContent
            </div>

            @if (ShowAcceptButton)
            {
                <button type="button" class="@AcceptButtonClass btn-block" @onclick="Accept">@(AcceptLabel ?? Strings.Get("accept"))</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowAcceptButton { get; set; } = true;
    [Parameter] public string? AcceptLabel { get; set; }
    [Parameter] public string AcceptButtonClass { get; set; } = "btn-primary";

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Accept()
    {
        await OnAccept.InvokeAsync();
        await Close();
    }
}
