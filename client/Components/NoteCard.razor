@using Client.Pages.Home
@inject UiStrings Strings

<div class="note-row">
    <div class="note-row-main" @onclick="Toggle">
        <h3 class="note-title">@Post.Title</h3>
        <p class="note-description">Description: @Post.Description</p>
    </div>

    @if (Post.IsExpanded)
    {
        <div class="note-stats">
            <button type="button" class="note-stat note-stat-toggle" @onclick="TogglePages">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                @Post.Pages.Count Pages
            </button>

            <button type="button" class="note-stat note-stat-toggle" @onclick="ToggleFiles">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>
                @Post.FileCount Files
            </button>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                @Post.LikedByUsers.Count Likes
            </span>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                @Post.Comments.Count Comments
            </span>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                @Post.FavoritedByUsers.Count Favorites
            </span>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><polyline points="7 23 3 19 7 15" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                @Post.RepostedByUsers.Count Reposts
            </span>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                @Post.Sends Sends
            </span>

            <span class="note-stat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                @Post.Downloads Downloads
            </span>

            <span class="note-stat-spacer"></span>

            <button type="button" class="note-action note-action-delete" @onclick="() => OnDelete.InvokeAsync(Post)">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>
                @Strings.Get("delete")
            </button>

            <button type="button" class="note-action note-action-group" @onclick="() => OnAddToGroup.InvokeAsync(Post)">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /><line x1="12" y1="11" x2="12" y2="17" /><line x1="9" y1="14" x2="15" y2="14" /></svg>
                @Strings.Get("addToGroup")
            </button>
        </div>

        @if (Post.ShowFiles)
        {
            <NoteFilePreview Post="Post" />
        }
        else if (Post.ShowGeneratedPreview)
        {
            <NoteGeneratedPreview Post="Post" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public EventCallback<Post> OnDelete { get; set; }
    [Parameter] public EventCallback<Post> OnAddToGroup { get; set; }

    private void Toggle() => Post.IsExpanded = !Post.IsExpanded;

    private void ToggleFiles()
    {
        Post.ShowFiles = !Post.ShowFiles;
        if (Post.ShowFiles)
            Post.ShowGeneratedPreview = false;
    }

    private void TogglePages()
    {
        Post.ShowGeneratedPreview = !Post.ShowGeneratedPreview;
        if (Post.ShowGeneratedPreview)
            Post.ShowFiles = false;
    }
}
