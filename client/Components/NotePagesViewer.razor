@using Client.Pages.Home
@using Client.Pages.CreateNote.Note.PageView
@using Client.Pages.CreateNote.Note.Toolbar
@using Client.Pages.CreateNote.Note.TableOfContents
@inject UiStrings Strings

@if (!AskAiMode)
{
    <div class="note-view">
        <div class="note-pages-row">
            <NotePageView @ref="LeftPageView" Page="LeftPage" EditMode="EditMode" DocumentTitle="@Title" />
            @if (RightPage is not null)
            {
                <NotePageView @ref="RightPageView" Page="RightPage" EditMode="EditMode" DocumentTitle="@Title" />
            }
        </div>

        @PaginationRow(GoToPage)
    </div>

    <NoteToolbar EditMode="EditMode" OnToggleEdit="() => EditMode = true" OnDone="SaveAndExitEditMode" OnShowToc="() => TocOpen = true" OnAskAi="HandleAskAiClick" />

    <NoteTableOfContents IsOpen="TocOpen" IsOpenChanged="@(open => TocOpen = open)" Pages="Pages" OnSelectPage="GoToPage" />
}
else
{
    <div class="note-ai-view">
        <div class="note-ai-bubble-panel">
            @foreach (var highlight in VisibleBubbles)
            {
                var lastMessage = highlight.Messages[^1];
                <div class="note-ai-bubble" @key="highlight.Id">
                    <div class="note-ai-bubble-header-row">
                        <button type="button" class="note-ai-bubble-dismiss" @onclick="() => Dismiss(highlight.Id)" aria-label="Dismiss">×</button>
                        <button type="button" class="note-ai-bubble-header" @onclick="() => ToggleBubble(highlight.Id)">
                            <span>@highlight.SelectedText</span>
                            <span class="note-ai-bubble-caret" aria-hidden="true">@(IsCollapsed(highlight.Id) ? "▾" : "▴")</span>
                        </button>
                    </div>

                    @if (!IsCollapsed(highlight.Id))
                    {
                        <p class="note-ai-bubble-question">@lastMessage.Question</p>
                        <div class="note-ai-bubble-answer-card">
                            <span class="note-ai-bubble-star" aria-hidden="true">★</span>
                            <p>@lastMessage.Answer</p>
                        </div>
                        <input class="form-input note-ai-bubble-input" placeholder="@Strings.Get("askAiPlaceholder")"
                               value="@GetDraft(highlight.Id)" @oninput="e => SetDraft(highlight.Id, e.Value?.ToString() ?? string.Empty)"
                               @onkeydown="e => HandleBubbleKeydown(e, highlight)" />
                        <div class="note-ai-bubble-actions">
                            <span class="note-ai-bubble-chat-tag">@Strings.Get("aiChatsLabel")</span>
                            <button type="button" class="btn-primary note-ai-bubble-add-btn" @onclick="() => AddToDocument(highlight)">@Strings.Get("addToDocument")</button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="note-ai-single-page">
            <NotePageView @ref="SinglePageView" Page="LeftPage" EditMode="false" DocumentTitle="@Title"
                          EnableSelectionListener="true" OnTextSelected="HandleAutoAsk" />
            @PaginationRow(GoToSinglePage)
        </div>
    </div>

    <button type="button" class="btn-primary note-ai-done-btn" @onclick="() => AskAiMode = false">@Strings.Get("done")</button>
}

@code {
    [Parameter, EditorRequired] public List<NotePage> Pages { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public List<NoteHighlight> Highlights { get; set; } = [];
    [Parameter] public EventCallback OnDocumentChanged { get; set; }

    private bool EditMode { get; set; }
    private bool TocOpen { get; set; }
    private bool AskAiMode { get; set; }
    private int CurrentLeftPage { get; set; } = 1;

    private NotePageView? LeftPageView;
    private NotePageView? RightPageView;
    private NotePageView? SinglePageView;

    private readonly HashSet<Guid> _collapsedBubbles = [];
    private readonly HashSet<Guid> _dismissedBubbles = [];
    private readonly Dictionary<Guid, string> _bubbleDrafts = [];

    // A handful of generic openers so freshly-created bubbles don't all read identically —
    // picked deterministically from the selected text so the same phrase always gets the same one.
    private static readonly string[] DefaultQuestions =
    [
        "What does this mean?",
        "Can you explain this further?",
        "Why does this matter?",
        "When did this originate?",
    ];

    // Simple keyword check for "Add to Document": if the user's message reads like an edit
    // instruction, the mock answer replaces the highlighted text instead of just being
    // appended after it. No real language understanding — just a word match.
    private static readonly string[] EditKeywords =
        ["kısalt", "değiştir", "düzelt", "shorten", "rewrite", "fix", "edit", "replace", "correct"];

    private NotePage LeftPage => Pages[CurrentLeftPage - 1];
    private NotePage? RightPage => CurrentLeftPage < Pages.Count ? Pages[CurrentLeftPage] : null;

    private IEnumerable<NoteHighlight> VisibleBubbles =>
        Highlights.Where(h => h.PageNumber == CurrentLeftPage && !_dismissedBubbles.Contains(h.Id));

    private void GoToPage(int number) =>
        CurrentLeftPage = number % 2 == 0 ? number - 1 : number;

    private void GoToSinglePage(int number) =>
        CurrentLeftPage = number;

    private async Task SaveAndExitEditMode()
    {
        if (LeftPageView is not null)
            LeftPage.Body = await LeftPageView.GetEditedHtmlAsync();

        if (RightPage is not null && RightPageView is not null)
            RightPage.Body = await RightPageView.GetEditedHtmlAsync();

        EditMode = false;
        await OnDocumentChanged.InvokeAsync();
    }

    // Whichever of the two open pages actually has a selection wins. The selection is wrapped
    // into a highlight mark immediately (before anything else happens) — the text a user has
    // selected is only reliably available right at the moment of the click.
    private async Task HandleAskAiClick()
    {
        NotePageView? view = null;
        var pageNumber = 0;
        string? text = null;

        if (LeftPageView is not null)
        {
            var leftText = await LeftPageView.GetSelectionTextAsync();
            if (!string.IsNullOrWhiteSpace(leftText))
            {
                (view, pageNumber, text) = (LeftPageView, LeftPage.Number, leftText);
            }
        }

        if (text is null && RightPage is not null && RightPageView is not null)
        {
            var rightText = await RightPageView.GetSelectionTextAsync();
            if (!string.IsNullOrWhiteSpace(rightText))
                (view, pageNumber, text) = (RightPageView, RightPage.Number, rightText);
        }

        if (view is null || text is null)
            return;

        await CreateBubbleAsync(view, pageNumber, text);
        CurrentLeftPage = pageNumber;
        AskAiMode = true;
    }

    // Once already in Ask AI mode there's no toolbar to click — selecting more text on the
    // single page is enough on its own to open another bubble (NotePageView's mouseup listener).
    private async Task HandleAutoAsk()
    {
        if (SinglePageView is null)
            return;

        var text = await SinglePageView.GetSelectionTextAsync();
        if (string.IsNullOrWhiteSpace(text))
            return;

        await CreateBubbleAsync(SinglePageView, CurrentLeftPage, text);
    }

    private async Task CreateBubbleAsync(NotePageView view, int pageNumber, string text)
    {
        var highlightId = Guid.NewGuid();
        await view.ApplyHighlightAsync(highlightId);

        var question = DefaultQuestions[Math.Abs(text.GetHashCode()) % DefaultQuestions.Length];
        var highlight = new NoteHighlight { Id = highlightId, PageNumber = pageNumber, SelectedText = text };
        highlight.Messages.Add(new AiChatMessage { Question = question, Answer = NoteAiMockResponder.Answer(question, text, Title) });
        Highlights.Add(highlight);
    }

    private void HandleBubbleKeydown(KeyboardEventArgs e, NoteHighlight highlight)
    {
        if (e.Key != "Enter")
            return;

        var draft = GetDraft(highlight.Id).Trim();
        if (draft.Length == 0)
            return;

        highlight.Messages.Add(new AiChatMessage { Question = draft, Answer = NoteAiMockResponder.Answer(draft, highlight.SelectedText, Title) });
        SetDraft(highlight.Id, "");
    }

    private async Task AddToDocument(NoteHighlight highlight)
    {
        if (SinglePageView is null || highlight.PageNumber != CurrentLeftPage)
            return;

        var lastMessage = highlight.Messages[^1];
        var isEditRequest = EditKeywords.Any(k => lastMessage.Question.Contains(k, StringComparison.OrdinalIgnoreCase));
        await SinglePageView.ApplyDocumentEditAsync(highlight.Id, lastMessage.Answer, isEditRequest);
        await OnDocumentChanged.InvokeAsync();
    }

    private bool IsCollapsed(Guid id) => _collapsedBubbles.Contains(id);

    private void ToggleBubble(Guid id)
    {
        if (!_collapsedBubbles.Remove(id))
            _collapsedBubbles.Add(id);
    }

    private void Dismiss(Guid id) => _dismissedBubbles.Add(id);

    private string GetDraft(Guid id) => _bubbleDrafts.TryGetValue(id, out var value) ? value : "";

    private void SetDraft(Guid id, string value) => _bubbleDrafts[id] = value;

    private List<int?> PaginationItems => PageNumberPagination.GetItems(Pages.Count, CurrentLeftPage);

    private RenderFragment PaginationRow(Action<int> onSelect) => @<div class="note-file-pagination">
        @foreach (var item in PaginationItems)
        {
            @if (item is null)
            {
                <span class="note-page-ellipsis">…</span>
            }
            else
            {
                var pageNumber = item.Value;
                <button type="button" class="note-page-btn @(pageNumber == CurrentLeftPage ? "note-page-btn-active" : "")" @onclick="() => onSelect(pageNumber)">
                    @pageNumber
                </button>
            }
        }
    </div>;
}
