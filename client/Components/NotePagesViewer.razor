@using Client.Pages.Home
@using Client.Pages.CreateNote.Note.PageView
@using Client.Pages.CreateNote.Note.Toolbar
@using Client.Pages.CreateNote.Note.TableOfContents
@using Client.Services
@inject PostsApiClient PostsApi
@inject UiStrings Strings
@inject IJSRuntime JS

@if (!AskAiMode)
{
    <div class="note-view">
        <div class="note-pages-row">
            <button type="button" class="note-page-arrow note-page-side-arrow" disabled="@(CurrentLeftPage - 2 < 1)" @onclick="() => GoToPage(CurrentLeftPage - 2)" aria-label="Previous page">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>

            <NotePageView @ref="LeftPageView" Page="LeftPage" EditMode="EditMode" DocumentTitle="@Title" />
            @if (RightPage is not null)
            {
                <NotePageView @ref="RightPageView" Page="RightPage" EditMode="EditMode" DocumentTitle="@Title" />
            }

            <button type="button" class="note-page-arrow note-page-side-arrow" disabled="@(CurrentLeftPage + 2 > Pages.Count)" @onclick="() => GoToPage(CurrentLeftPage + 2)" aria-label="Next page">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
        </div>

        <NotePagination Total="Pages.Count" Current="CurrentLeftPage" Step="2" OnSelect="GoToPage" />
    </div>

    @* Hidden on screen — visible only for @media print (see app.css), so "Download" (which
       just opens the browser's print dialog) produces every page of the note, not just the
       two currently on screen. *@
    <div class="note-print-pages">
        <h1 class="note-print-title">@Title</h1>
        @foreach (var page in Pages)
        {
            <NotePageView Page="page" EditMode="false" DocumentTitle="@Title" />
        }
    </div>

    <NoteToolbar EditMode="EditMode" Posted="Posted" IsAuthor="IsAuthor" OnToggleEdit="() => EditMode = true" OnDone="SaveAndExitEditMode" OnShowToc="() => TocOpen = true" OnAskAi="HandleAskAiClick" OnShare="OnShare" OnDownload="OpenPdfPreview" PersonalNotes="PersonalNotes" PersonalNotesChanged="OnPersonalNotesChanged" />

    <NoteTableOfContents IsOpen="TocOpen" IsOpenChanged="@(open => TocOpen = open)" Pages="Pages" OnSelectPage="GoToPage" />
}
else
{
    <div class="note-ai-view">
        <div class="note-ai-bubble-panel">
            @foreach (var highlight in VisibleBubbles)
            {
                var hasMessages = highlight.Messages.Count > 0;
                var lastMessage = hasMessages ? highlight.Messages[^1] : null;
                <div class="note-ai-bubble" @key="highlight.Id">
                    <div class="note-ai-bubble-header-row">
                        <button type="button" class="note-ai-bubble-dismiss" @onclick="() => Dismiss(highlight.Id)" aria-label="Dismiss">×</button>
                        <button type="button" class="note-ai-bubble-header" @onclick="() => ToggleBubble(highlight.Id)">
                            <span>@highlight.SelectedText</span>
                            <span class="note-ai-bubble-caret" aria-hidden="true">@(IsCollapsed(highlight.Id) ? "▾" : "▴")</span>
                        </button>
                    </div>

                    @if (!IsCollapsed(highlight.Id))
                    {
                        @if (hasMessages)
                        {
                            var isLoading = string.IsNullOrEmpty(lastMessage!.Answer);
                            <p class="note-ai-bubble-question">@lastMessage.Question</p>
                            <div class="note-ai-bubble-answer-card">
                                <span class="note-ai-bubble-star" aria-hidden="true">★</span>
                                <p>@(isLoading ? Strings.Get("askAiThinking") : lastMessage.Answer)</p>
                            </div>
                            <textarea class="form-input note-ai-bubble-input" placeholder="@Strings.Get("askAiPlaceholder")" disabled="@isLoading" rows="1"
                                      value="@GetDraft(highlight.Id)" @oninput="e => SetDraft(highlight.Id, e.Value?.ToString() ?? string.Empty)"
                                      @onkeydown="e => HandleBubbleKeydown(e, highlight)"></textarea>
                            <div class="note-ai-bubble-actions">
                                <button type="button" class="btn-primary note-ai-bubble-add-btn" disabled="@isLoading" @onclick="() => AddToDocument(highlight)">@Strings.Get("addToDocument")</button>
                            </div>
                        }
                        else
                        {
                            // No question asked yet — the user's own first question (not an
                            // auto-picked one) is what actually creates and persists this
                            // highlight, in HandleBubbleKeydown below.
                            <textarea class="form-input note-ai-bubble-input" placeholder="@Strings.Get("askAiPlaceholder")" rows="1"
                                      value="@GetDraft(highlight.Id)" @oninput="e => SetDraft(highlight.Id, e.Value?.ToString() ?? string.Empty)"
                                      @onkeydown="e => HandleBubbleKeydown(e, highlight)"></textarea>
                        }
                    }
                </div>
            }
        </div>

        <div class="note-ai-single-page">
            <div class="note-pages-row">
                <button type="button" class="note-page-arrow note-page-side-arrow" disabled="@(CurrentLeftPage - 1 < 1)" @onclick="() => GoToSinglePage(CurrentLeftPage - 1)" aria-label="Previous page">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                </button>

                <NotePageView @ref="SinglePageView" Page="LeftPage" EditMode="false" DocumentTitle="@Title"
                              EnableSelectionListener="true" OnTextSelected="HandleAutoAsk" />

                <button type="button" class="note-page-arrow note-page-side-arrow" disabled="@(CurrentLeftPage + 1 > Pages.Count)" @onclick="() => GoToSinglePage(CurrentLeftPage + 1)" aria-label="Next page">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                </button>
            </div>
            <NotePagination Total="Pages.Count" Current="CurrentLeftPage" OnSelect="GoToSinglePage" />
        </div>
    </div>

    @if (GeneralChatOpen)
    {
        <div class="note-ai-general-chat" data-floating-widget>
            <div class="note-ai-general-chat-header">
                <span>@Strings.Get("askToAi")</span>
                <button type="button" class="note-ai-general-chat-close" @onclick="() => GeneralChatOpen = false" aria-label="Close">×</button>
            </div>
            <div class="note-ai-general-chat-messages">
                @if (GeneralChatMessages.Count == 0)
                {
                    <p class="note-ai-general-chat-empty">@Strings.Get("askAiGeneralEmpty")</p>
                }
                @foreach (var message in GeneralChatMessages)
                {
                    <div class="note-ai-bubble-message">
                        <p class="note-ai-bubble-question">@message.Question</p>
                        <div class="note-ai-bubble-answer-card">
                            <span class="note-ai-bubble-star" aria-hidden="true">★</span>
                            <p>@(string.IsNullOrEmpty(message.Answer) ? Strings.Get("askAiThinking") : message.Answer)</p>
                        </div>
                    </div>
                }
            </div>
            <textarea class="note-ai-general-chat-input" placeholder="@Strings.Get("askAiPlaceholder")" rows="1"
                      value="@GeneralChatDraft" @oninput="e => GeneralChatDraft = e.Value?.ToString() ?? string.Empty"
                      @onkeydown="HandleGeneralChatKeydown"></textarea>
        </div>
    }

    <div class="note-ai-bottom-actions" data-floating-widget>
        <button type="button" class="note-ai-general-chat-toggle @(GeneralChatOpen ? "note-ai-general-chat-toggle-active" : "")"
                @onclick="() => GeneralChatOpen = !GeneralChatOpen" aria-label="@Strings.Get("askToAi")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
        </button>
        <button type="button" class="btn-primary" @onclick="() => AskAiMode = false">@Strings.Get("done")</button>
    </div>
}

@if (PdfPreviewOpen)
{
    <div class="pdf-preview-overlay">
        <div class="pdf-preview-box">
            <div class="pdf-preview-header">
                <span>@($"{Title}.pdf")</span>
                <button type="button" class="modal-close" @onclick="ClosePdfPreview" aria-label="Close">&times;</button>
            </div>

            @if (PdfLoading)
            {
                <div class="pdf-preview-loading">
                    <div class="wizard-spinner" aria-hidden="true"></div>
                </div>
            }
            else if (PdfBytes is null)
            {
                <p class="stub-text pdf-preview-loading">@Strings.Get("generationFailed")</p>
            }
            else
            {
                <iframe id="pdf-preview-frame" class="pdf-preview-frame" title="@Title"></iframe>
            }

            <div class="pdf-preview-actions">
                <button type="button" class="btn-secondary" @onclick="ClosePdfPreview">@Strings.Get("back")</button>
                <button type="button" class="btn-primary" disabled="@(PdfBytes is null)" @onclick="DownloadPdf">@Strings.Get("download")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<NotePage> Pages { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public List<NoteHighlight> Highlights { get; set; } = [];

    // Needed only for the general (non-highlight) chatbox, which calls the Ask AI endpoint
    // directly rather than bubbling through a callback — it doesn't mutate any Post state a
    // parent needs to persist, so there's nothing for the caller to do with the result.
    [Parameter] public int? PostId { get; set; }
    [Parameter] public EventCallback OnDocumentChanged { get; set; }
    [Parameter] public bool Posted { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    // Defaults true: the create-note wizard (NoteStep.razor) never renders this for anyone but
    // the author. NoteReaderPage.razor is the one caller that passes false, for a viewer who
    // isn't the note's author — Ask AI, manual edit, and share are meaningless (and the server
    // already rejects them) for someone else's note.
    [Parameter] public bool IsAuthor { get; set; } = true;

    // Fired whenever a page's Body actually changes (manual edit, a new highlight wrapping
    // its text, or Add to Document) so the caller can persist it — Page.Body is already
    // mutated in place by the time these fire, this just tells the caller which page to save.
    [Parameter] public EventCallback<NotePage> OnPageBodyChanged { get; set; }
    // Same as OnPageBodyChanged, but for highlights/edits that landed in Page.Heading instead.
    [Parameter] public EventCallback<NotePage> OnPageHeadingChanged { get; set; }
    [Parameter] public EventCallback<NoteHighlight> OnHighlightCreated { get; set; }
    [Parameter] public EventCallback<(Guid HighlightId, AiChatMessage Message)> OnHighlightMessageAdded { get; set; }
    // Fired when the user clicks "Add to Document" on an already-answered message, so the
    // caller can flag that specific message as one that actually changed the document (see
    // Process page grouping) rather than just bumping the generic document-change counter.
    [Parameter] public EventCallback<(Guid HighlightId, int MessageId)> OnHighlightAddedToDocument { get; set; }

    // The author's own free-form scratchpad, shown from NoteToolbar's "More" panel — "" and
    // its callback left unbound for a non-author viewer (IsAuthor false), same as every other
    // author-only tool this component exposes.
    [Parameter] public string PersonalNotes { get; set; } = "";
    [Parameter] public EventCallback<string> OnPersonalNotesChanged { get; set; }

    private bool EditMode { get; set; }
    private bool TocOpen { get; set; }
    private bool PdfPreviewOpen { get; set; }
    private bool PdfLoading { get; set; }
    private byte[]? PdfBytes { get; set; }
    private bool AskAiMode { get; set; }
    private int CurrentLeftPage { get; set; } = 1;

    private NotePageView? LeftPageView;
    private NotePageView? RightPageView;
    private NotePageView? SinglePageView;

    private readonly HashSet<Guid> _collapsedBubbles = [];
    private readonly HashSet<Guid> _dismissedBubbles = [];
    private readonly Dictionary<Guid, string> _bubbleDrafts = [];

    // General, not-tied-to-any-highlight AI chat — separate from the per-word bubbles, so it
    // isn't a NoteHighlight and doesn't show up in Process (nothing was selected to anchor it to).
    private bool GeneralChatOpen { get; set; }
    private readonly List<AiChatMessage> GeneralChatMessages = [];
    private string GeneralChatDraft { get; set; } = "";
    private string? _generalChatThreadId;

    // Simple keyword check for "Add to Document": if the user's message reads like an edit
    // instruction, the mock answer replaces the highlighted text instead of just being
    // appended after it. No real language understanding — just a word match.
    private static readonly string[] EditKeywords =
        ["kısalt", "değiştir", "düzelt", "shorten", "rewrite", "fix", "edit", "replace", "correct"];

    // Which specific command(s) a formatting instruction maps to — only consulted once
    // AiChatMessage.IsFormatInstruction (set from the agent's own [FORMAT] marker) says the
    // message really was one; see AddToDocument below. Grouped so a message can combine
    // commands from *different* groups (e.g. "kırmızı ve kalın yap" → TextRed + Bold, two
    // different CSS properties applied to the same span) while still only ever picking one
    // command *within* a group (e.g. never both Subtitle and Heading, or both pink and blue
    // highlight, for one message) — within a group, order matters and the first match wins:
    // "subtitle" must come before "heading" since "alt başlık" contains "başlık" as a
    // substring, and "kırmızı"/"red" is listed last in its own group (a group of one) since
    // it's common enough as a plain descriptive word (e.g. "bu kırmızı yazıyı pembe highlight
    // yap", describing the text's current color while asking for something else) that other
    // groups should get first refusal.
    //
    // No group matching at all leaves the document untouched in AddToDocument — the agent
    // recognized a formatting instruction but this table doesn't have a specific handler for
    // it yet, so it's better to do nothing than guess.
    private static readonly (string[] Keywords, NoteFormatCommand Command)[][] FormatCommandGroups =
    [
        [(["subtitle", "alt başlık", "altbaşlık"], NoteFormatCommand.Subtitle), (["head", "başlık", "heading"], NoteFormatCommand.Heading)],
        [(["pink", "pembe"], NoteFormatCommand.HighlightPink), (["blue", "mavi"], NoteFormatCommand.HighlightBlue), (["green", "yeşil"], NoteFormatCommand.HighlightGreen)],
        [(["kalın", "bold"], NoteFormatCommand.Bold)],
        [(["büyüt", "büyült", "enlarge", "bigger", "larger"], NoteFormatCommand.Enlarge)],
        [(["red", "kırmızı"], NoteFormatCommand.TextRed)],
    ];

    private static List<NoteFormatCommand> DetectFormatCommands(string question) =>
        FormatCommandGroups
            .Select(group => group.FirstOrDefault(fc => fc.Keywords.Any(k => question.Contains(k, StringComparison.OrdinalIgnoreCase))).Command)
            .Where(command => command != NoteFormatCommand.None)
            .ToList();

    private NotePage LeftPage => Pages[CurrentLeftPage - 1];
    private NotePage? RightPage => CurrentLeftPage < Pages.Count ? Pages[CurrentLeftPage] : null;

    private IEnumerable<NoteHighlight> VisibleBubbles =>
        Highlights.Where(h => h.PageNumber == CurrentLeftPage && !_dismissedBubbles.Contains(h.Id));

    private void GoToPage(int number) =>
        CurrentLeftPage = number % 2 == 0 ? number - 1 : number;

    private void GoToSinglePage(int number) =>
        CurrentLeftPage = number;

    private async Task SaveAndExitEditMode()
    {
        if (LeftPageView is not null)
        {
            LeftPage.Body = await LeftPageView.GetEditedHtmlAsync();
            await OnPageBodyChanged.InvokeAsync(LeftPage);
        }

        if (RightPage is not null && RightPageView is not null)
        {
            RightPage.Body = await RightPageView.GetEditedHtmlAsync();
            await OnPageBodyChanged.InvokeAsync(RightPage);
        }

        EditMode = false;
        await OnDocumentChanged.InvokeAsync();
    }

    // The book icon only switches into Ask AI mode — it never creates a highlight by itself.
    // Highlighting is always the user's own action: they select a word/phrase inside Ask AI
    // mode, and that real selection (via NotePageView's mouseup listener) is what opens a bubble.
    private void HandleAskAiClick() => AskAiMode = true;

    // Selecting text on the single page is what actually creates a bubble — the only path in,
    // by design (see HandleAskAiClick above). Works the same whether the selection was made in
    // the page's Heading or its Body — NotePageView tracks which one fired.
    private async Task HandleAutoAsk()
    {
        if (SinglePageView is null)
            return;

        var text = await SinglePageView.GetSelectionTextAsync();
        if (string.IsNullOrWhiteSpace(text))
            return;

        await CreateBubbleAsync(SinglePageView, CurrentLeftPage, text, SinglePageView.LastSelectionTargetsHeading);
    }

    // Only wraps the selection and opens an empty bubble — no question is asked yet. The user
    // types their own first question (never an auto-picked one) before anything is sent to the
    // agent; see HandleBubbleKeydown, which handles both that first question and every
    // follow-up through the same path.
    private async Task CreateBubbleAsync(NotePageView view, int pageNumber, string text, bool targetsHeading)
    {
        var highlightId = Guid.NewGuid();
        await view.ApplyHighlightAsync(highlightId, targetsHeading);

        if (targetsHeading)
            await OnPageHeadingChanged.InvokeAsync(Pages[pageNumber - 1]);
        else
            await OnPageBodyChanged.InvokeAsync(Pages[pageNumber - 1]);

        var highlight = new NoteHighlight { Id = highlightId, PageNumber = pageNumber, SelectedText = text, TargetsHeading = targetsHeading };
        Highlights.Add(highlight);
    }

    // The Answer starts empty — the bubble renders a loading state until the caller's server
    // round-trip (interactive-chat-agent-synapse) fills it in, in place, on the same message
    // object. StateHasChanged forces that loading state to actually paint before the (slow)
    // await. Whether this is the highlight's first question (creates + persists it) or a
    // follow-up (appends to an already-persisted one) is just whether Messages was empty.
    private async Task HandleBubbleKeydown(KeyboardEventArgs e, NoteHighlight highlight)
    {
        if (e.Key != "Enter" || e.ShiftKey)
            return;

        var draft = GetDraft(highlight.Id).Trim();
        if (draft.Length == 0)
            return;

        var isFirstQuestion = highlight.Messages.Count == 0;
        var message = new AiChatMessage { Question = draft };
        highlight.Messages.Add(message);
        SetDraft(highlight.Id, "");
        StateHasChanged();

        if (isFirstQuestion)
            await OnHighlightCreated.InvokeAsync(highlight);
        else
            await OnHighlightMessageAdded.InvokeAsync((highlight.Id, message));
    }

    private async Task AddToDocument(NoteHighlight highlight)
    {
        if (SinglePageView is null || highlight.PageNumber != CurrentLeftPage)
            return;

        var lastMessage = highlight.Messages[^1];
        if (lastMessage.IsFormatInstruction)
        {
            // The agent confirms this was a formatting instruction, but only apply it if this
            // table actually has at least one matching command — otherwise leave the document
            // untouched. Never fall through to inserting lastMessage.Answer here: it's an
            // acknowledgment ("Tamam — 'Add to Document'a tıklayınca..."), not real content.
            var formatCommands = DetectFormatCommands(lastMessage.Question);
            if (formatCommands.Count > 0)
                await SinglePageView.ApplyFormatCommandsAsync(highlight.Id, formatCommands, highlight.TargetsHeading);
        }
        else
        {
            var isEditRequest = EditKeywords.Any(k => lastMessage.Question.Contains(k, StringComparison.OrdinalIgnoreCase));
            await SinglePageView.ApplyDocumentEditAsync(highlight.Id, lastMessage.Answer, isEditRequest, highlight.TargetsHeading);
        }

        if (highlight.TargetsHeading)
            await OnPageHeadingChanged.InvokeAsync(LeftPage);
        else
            await OnPageBodyChanged.InvokeAsync(LeftPage);

        // AddedToDocument itself is set by Store.MarkAddedToDocumentAsync (via
        // OnHighlightAddedToDocument below) only once the server confirms it — not here — so a
        // failed request never leaves the UI showing "Added to Document" for an edit that
        // didn't actually persist.
        if (lastMessage.Id != 0)
            await OnHighlightAddedToDocument.InvokeAsync((highlight.Id, lastMessage.Id));
        else
            await OnDocumentChanged.InvokeAsync();
    }

    private async Task HandleGeneralChatKeydown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || e.ShiftKey || PostId is null)
            return;

        var question = GeneralChatDraft.Trim();
        if (question.Length == 0)
            return;

        var message = new AiChatMessage { Question = question };
        GeneralChatMessages.Add(message);
        GeneralChatDraft = "";
        StateHasChanged();

        var response = await PostsApi.AskAsync(PostId.Value, new AskAiRequest { Question = question, ThreadId = _generalChatThreadId });
        if (response is null)
            return;

        // No document to act on here (no highlight, no Add to Document), so the format flag
        // itself is irrelevant — only strip the marker so it never shows up in the bubble.
        message.Answer = AiFormatAcknowledgment.Strip(response.Answer, out _);
        _generalChatThreadId = response.ThreadId;
    }

    private bool IsCollapsed(Guid id) => _collapsedBubbles.Contains(id);

    private void ToggleBubble(Guid id)
    {
        if (!_collapsedBubbles.Remove(id))
            _collapsedBubbles.Add(id);
    }

    // Dismissing a bubble removes both the bubble UI and the underlying highlight mark from
    // the note text (the text itself, including any Add to Document insertion, stays).
    private async Task Dismiss(Guid id)
    {
        _dismissedBubbles.Add(id);

        var highlight = Highlights.FirstOrDefault(h => h.Id == id);
        if (highlight is null || SinglePageView is null || highlight.PageNumber != CurrentLeftPage)
            return;

        await SinglePageView.RemoveHighlightAsync(id, highlight.TargetsHeading);
        if (highlight.TargetsHeading)
            await OnPageHeadingChanged.InvokeAsync(LeftPage);
        else
            await OnPageBodyChanged.InvokeAsync(LeftPage);
    }

    private string GetDraft(Guid id) => _bubbleDrafts.TryGetValue(id, out var value) ? value : "";

    private void SetDraft(Guid id, string value) => _bubbleDrafts[id] = value;

    // The iframe only exists in the DOM once PdfBytes is non-null and PdfLoading is false —
    // pointing it at the blob URL has to wait for OnAfterRenderAsync (guaranteed to run after
    // that DOM update lands) rather than firing right after the await in OpenPdfPreview, which
    // would race the render and could find no <iframe> there yet.
    private bool _pdfReadyForJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pdfReadyForJs)
        {
            _pdfReadyForJs = false;
            await JS.InvokeVoidAsync("pdfPreview.show", PdfBytes, "pdf-preview-frame");
        }
    }

    private async Task OpenPdfPreview()
    {
        if (PostId is null)
            return;

        PdfPreviewOpen = true;
        PdfLoading = true;
        PdfBytes = null;

        PdfBytes = await PostsApi.GetPdfAsync(PostId.Value);
        PdfLoading = false;
        _pdfReadyForJs = PdfBytes is not null;
    }

    private async Task ClosePdfPreview()
    {
        PdfPreviewOpen = false;
        PdfBytes = null;
        await JS.InvokeVoidAsync("pdfPreview.revoke", "pdf-preview-frame");
    }

    private async Task DownloadPdf()
    {
        if (PdfBytes is not null)
            await JS.InvokeVoidAsync("pdfPreview.download", PdfBytes, $"{Title}.pdf");
    }
}
