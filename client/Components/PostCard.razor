@using Client.Pages.Home
@using Client.Pages.CreateNote.Note.PageView
@using Client.Services
@inject UiStrings Strings
@inject NotesStore Store
@inject AuthState AuthState
@inject NavigationManager Navigation

<div class="post-card @(IsAdmin ? "post-card-admin" : "")" @onclick="Toggle">
    <h2 class="post-title">
        @Post.Title
        @if (!string.IsNullOrWhiteSpace(Post.MiniDescription))
        {
            <span class="post-title-desc">| @Post.MiniDescription</span>
        }
    </h2>

    <div class="post-preview-divider" @onclick:stopPropagation="true">
        <button type="button" class="post-preview-toggle" @onclick="() => Post.ShowNotePreview = !Post.ShowNotePreview" aria-label="Toggle note preview">
            @(Post.ShowNotePreview ? "▲" : "▼")
        </button>
    </div>

    @if (!Post.ShowNotePreview)
    {
        @* Shows the actual generated note's first page (not a raw-file preview — the uploaded
           files are just the note's source material) plus quick links to its other views. *@
        <div class="post-pages">
            @foreach (var (_, pageNumber) in FlattenedPages.Take(3))
            {
                <button type="button" class="post-page-thumb" @onclick="() => Post.ShowNotePreview = true" @onclick:stopPropagation="true">
                    <span class="post-page-thumb-line" style="width: 70%"></span>
                    <span class="post-page-thumb-line" style="width: 90%"></span>
                    <span class="post-page-thumb-line" style="width: 60%"></span>
                    <span class="post-page-thumb-line" style="width: 80%"></span>
                    <span class="post-page-thumb-number">@pageNumber</span>
                </button>
            }
            @if (Post.TotalPageCount > 3)
            {
                <button type="button" class="post-page-more" @onclick="() => Post.ShowNotePreview = true" @onclick:stopPropagation="true">…</button>
            }
        </div>
    }
    else
    {
        <div class="post-note-preview" @onclick:stopPropagation="true">
            <div class="post-note-preview-actions">
                @* Unlike NoteReaderPage's own dashboard, this feed card mirrors exactly what
                   any other viewer would see — no author bypass — so the share toggles
                   actually look like they did something when you're looking at your own
                   post in your own feed. The full dashboard (via "Note") still always has
                   all three for the author. *@
                <button type="button" class="post-note-preview-btn" @onclick="GoToNote">@Strings.Get("noteButton")</button>
                @if (Post.ShareBrainMap)
                {
                    <button type="button" class="post-note-preview-btn" @onclick="GoToBrainMap">@Strings.Get("brainMapButton")</button>
                }
                @if (Post.ShareProcess)
                {
                    <button type="button" class="post-note-preview-btn" @onclick="GoToProcess">@Strings.Get("process")</button>
                }
                <button type="button" class="post-note-preview-btn" @onclick="GoToMap">@Strings.Get("mapButton")</button>
            </div>
            <div class="post-note-preview-page-wrap">
                <div class="post-note-preview-page">
                    @if (Post.FirstPage is not null)
                    {
                        <NotePageView Page="Post.FirstPage" EditMode="false" DocumentTitle="@Post.Title" />
                    }
                    else
                    {
                        <p class="stub-text">@Strings.Get("noGeneratedNoteYet")</p>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Post.Description))
    {
        <p class="post-description">@Post.Description</p>
    }

    <div class="post-footer">
        <a class="post-author-link" href="@($"/profile/{Uri.EscapeDataString(Post.AuthorName)}")" @onclick:stopPropagation="true">
            <span class="avatar-circle" aria-hidden="true">@Post.AuthorName.Substring(0, 1)</span>
            <div class="post-author">
                <p class="post-author-name">@Post.AuthorName</p>
                <p class="post-author-role">@Post.AuthorRole</p>
            </div>
        </a>
        @if (ShowFollowButton && Post.AuthorId != AuthState.CurrentUser?.Id)
        {
            <button type="button" class="@(Post.IsFollowing ? "btn-secondary" : "btn-primary")" @onclick="ToggleFollow" @onclick:stopPropagation="true">
                @(Post.IsFollowing ? Strings.Get("following") : Strings.Get("follow"))
            </button>
        }

        @if (IsAdmin)
        {
            <button type="button" class="post-action-icon post-delete-icon" title="@Strings.Get("delete")" @onclick="() => DeletePostModalOpen = true" @onclick:stopPropagation="true">
                @TrashIcon
            </button>
        }

        @if (Post.IsExpanded)
        {
            <div class="post-actions">
                <span class="post-action">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                    @Post.Comments.Count Comments
                </span>

                <button type="button" class="post-action post-action-toggle @(Post.LikedByMe ? "post-action-liked" : "")" disabled="@IsAdmin" title="@(IsAdmin ? Strings.Get("adminCannotInteract") : null)" @onclick="ToggleLike" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="@(Post.LikedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    @Post.LikeCount Likes
                </button>

                <span class="post-action-spacer"></span>

                <button type="button" class="post-action-icon post-action-toggle @(Post.FavoritedByMe ? "post-action-favorited" : "")" title="@(IsAdmin ? Strings.Get("adminCannotInteract") : "Favorite")" disabled="@IsAdmin" @onclick="ToggleFavorite" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="@(Post.FavoritedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                </button>

                <span class="post-action-icon" title="Send">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                </span>

                <button type="button" class="post-action-icon post-action-toggle @(Post.RepostedByMe ? "post-action-reposted" : "")" title="Repost" @onclick="ToggleRepost" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="@(Post.RepostedByMe ? "3" : "2")" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><polyline points="7 23 3 19 7 15" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                </button>

                <a class="post-action-icon" title="Download" href="@Post.Files[0].FileUrl" target="_blank" rel="noopener" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                </a>
            </div>
        }
    </div>

    @if (Post.IsExpanded)
    {
        <div class="post-comments" @onclick:stopPropagation="true">
            @foreach (var comment in Post.Comments)
            {
                <div class="post-comment">
                    <span class="avatar-circle" aria-hidden="true">@comment.AuthorName.Substring(0, 1)</span>
                    <div class="post-comment-body">
                        <p>@comment.Text</p>
                    </div>
                    @if (IsAdmin)
                    {
                        <button type="button" class="post-action-icon post-delete-icon post-comment-delete-icon" title="@Strings.Get("delete")" @onclick="() => DeleteComment(comment)" @onclick:stopPropagation="true">
                            @TrashIcon
                        </button>
                    }
                </div>
            }

            @if (!IsAdmin)
            {
                <div class="post-comment-form">
                    <input class="form-input" placeholder="Write a comment..." @bind="NewCommentText" @onkeydown="HandleCommentKeydown" />
                    <button type="button" class="btn-primary" @onclick="AddComment">@Strings.Get("post")</button>
                </div>
            }
        </div>
    }
</div>

@if (IsAdmin)
{
    <Modal IsOpen="DeletePostModalOpen" IsOpenChanged="@(open => DeletePostModalOpen = open)" OnAccept="DeletePost" AcceptLabel="@Strings.Get("delete")" AcceptButtonClass="btn-danger">
        <h3 class="modal-form-heading">@Strings.Get("delete")</h3>
        <p class="stub-text">@Strings.Get("deletePostConfirm")</p>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public bool ShowFollowButton { get; set; } = true;
    [Parameter] public EventCallback OnDeleted { get; set; }

    private bool IsAdmin => AuthState.IsAdmin;
    private bool DeletePostModalOpen { get; set; }

    private static readonly RenderFragment TrashIcon = @<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>;

    private string NewCommentText { get; set; } = "";

    private IEnumerable<(string FileUrl, int PageNumber)> FlattenedPages =>
        Post.Files.SelectMany(f => Enumerable.Range(1, f.PageCount).Select(p => (f.FileUrl, p)));

    private void Toggle() => Post.IsExpanded = !Post.IsExpanded;

    private void GoToNote() => Navigation.NavigateTo($"/notes/{Post.Id}");

    private void GoToBrainMap() => Navigation.NavigateTo($"/notes/{Post.Id}/brain-map");

    private void GoToProcess() => Navigation.NavigateTo($"/notes/{Post.Id}/process");

    private void GoToMap() => Navigation.NavigateTo($"/notes/{Post.Id}/map");

    private async Task ToggleFollow() => await Store.ToggleFollowAsync(Post);

    private async Task ToggleLike() => await Store.ToggleLikeAsync(Post);

    private async Task ToggleFavorite() => await Store.ToggleFavoriteAsync(Post);

    private async Task ToggleRepost() => await Store.ToggleRepostAsync(Post);

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(NewCommentText))
            return;

        await Store.AddCommentAsync(Post, NewCommentText.Trim());
        NewCommentText = "";
    }

    private async Task HandleCommentKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddComment();
    }

    private async Task DeletePost()
    {
        if (await Store.DeletePostAsync(Post))
            await OnDeleted.InvokeAsync();
    }

    private async Task DeleteComment(PostComment comment) => await Store.DeleteCommentAsync(Post, comment);
}
