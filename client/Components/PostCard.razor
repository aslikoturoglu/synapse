@using Client.Pages.Home
@inject UiStrings Strings

<div class="post-card" @onclick="Toggle">
    <h2 class="post-title">
        @Post.Title
        @if (!string.IsNullOrWhiteSpace(Post.MiniDescription))
        {
            <span class="post-title-desc">| @Post.MiniDescription</span>
        }
    </h2>

    <div class="post-pages">
        @foreach (var (_, pageNumber) in FlattenedPages.Take(3))
        {
            <button type="button" class="post-page-thumb" @onclick="ToggleFilePreview" @onclick:stopPropagation="true">
                <span class="post-page-thumb-line" style="width: 70%"></span>
                <span class="post-page-thumb-line" style="width: 90%"></span>
                <span class="post-page-thumb-line" style="width: 60%"></span>
                <span class="post-page-thumb-line" style="width: 80%"></span>
                <span class="post-page-thumb-number">@pageNumber</span>
            </button>
        }
        @if (Post.TotalPageCount > 3)
        {
            <button type="button" class="post-page-more" @onclick="ToggleFilePreview" @onclick:stopPropagation="true">…</button>
        }
    </div>

    @if (Post.ShowFiles)
    {
        <NoteFilePreview Post="Post" />
    }

    @if (!string.IsNullOrWhiteSpace(Post.Description))
    {
        <p class="post-description">@Post.Description</p>
    }

    <div class="post-footer">
        <a class="post-author-link" href="@($"/profile/{Uri.EscapeDataString(Post.AuthorName)}")" @onclick:stopPropagation="true">
            <span class="avatar-circle" aria-hidden="true">@Post.AuthorName.Substring(0, 1)</span>
            <div class="post-author">
                <p class="post-author-name">@Post.AuthorName</p>
                <p class="post-author-role">@Post.AuthorRole</p>
            </div>
        </a>
        @if (ShowFollowButton)
        {
            <button type="button" class="@(Post.IsFollowing ? "btn-secondary" : "btn-primary")" @onclick="ToggleFollow" @onclick:stopPropagation="true">
                @(Post.IsFollowing ? Strings.Get("following") : Strings.Get("follow"))
            </button>
        }

        @if (Post.IsExpanded)
        {
            <div class="post-actions">
                <span class="post-action">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                    @Post.Comments.Count Comments
                </span>

                <button type="button" class="post-action post-action-toggle @(IsLikedByMe ? "post-action-liked" : "")" @onclick="ToggleLike" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="@(IsLikedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    @Post.LikedByUsers.Count Likes
                </button>

                <span class="post-action-spacer"></span>

                <button type="button" class="post-action-icon post-action-toggle @(IsFavoritedByMe ? "post-action-favorited" : "")" title="Favorite" @onclick="ToggleFavorite" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="@(IsFavoritedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                </button>

                <span class="post-action-icon" title="Send">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                </span>

                <button type="button" class="post-action-icon post-action-toggle @(IsRepostedByMe ? "post-action-reposted" : "")" title="Repost" @onclick="ToggleRepost" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="@(IsRepostedByMe ? "3" : "2")" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><polyline points="7 23 3 19 7 15" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                </button>

                <a class="post-action-icon" title="Download" href="@Post.Files[0].FileUrl" target="_blank" rel="noopener" @onclick:stopPropagation="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                </a>
            </div>
        }
    </div>

    @if (Post.IsExpanded)
    {
        <div class="post-comments" @onclick:stopPropagation="true">
            @foreach (var comment in Post.Comments)
            {
                <div class="post-comment">
                    <span class="avatar-circle" aria-hidden="true">@comment.AuthorName.Substring(0, 1)</span>
                    <p>@comment.Text</p>
                </div>
            }

            <div class="post-comment-form">
                <input class="form-input" placeholder="Write a comment..." @bind="NewCommentText" @onkeydown="HandleCommentKeydown" />
                <button type="button" class="btn-primary" @onclick="AddComment">@Strings.Get("post")</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public bool ShowFollowButton { get; set; } = true;

    private string CurrentUser => NotesStore.CurrentUserName;

    private string NewCommentText { get; set; } = "";

    private IEnumerable<(string FileUrl, int PageNumber)> FlattenedPages =>
        Post.Files.SelectMany(f => Enumerable.Range(1, f.PageCount).Select(p => (f.FileUrl, p)));

    private bool IsLikedByMe => Post.LikedByUsers.Contains(CurrentUser);
    private bool IsFavoritedByMe => Post.FavoritedByUsers.Contains(CurrentUser);
    private bool IsRepostedByMe => Post.RepostedByUsers.Contains(CurrentUser);

    private void Toggle() => Post.IsExpanded = !Post.IsExpanded;

    private void ToggleFilePreview() => Post.ShowFiles = !Post.ShowFiles;

    private void ToggleFollow() => Post.IsFollowing = !Post.IsFollowing;

    private void ToggleLike()
    {
        if (!Post.LikedByUsers.Remove(CurrentUser))
            Post.LikedByUsers.Add(CurrentUser);
    }

    private void ToggleFavorite()
    {
        if (!Post.FavoritedByUsers.Remove(CurrentUser))
            Post.FavoritedByUsers.Add(CurrentUser);
    }

    private void ToggleRepost()
    {
        if (!Post.RepostedByUsers.Remove(CurrentUser))
            Post.RepostedByUsers.Add(CurrentUser);
    }

    private void AddComment()
    {
        if (string.IsNullOrWhiteSpace(NewCommentText))
            return;

        Post.Comments.Add(new PostComment { AuthorName = CurrentUser, Text = NewCommentText.Trim() });
        NewCommentText = "";
    }

    private void HandleCommentKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddComment();
    }
}
