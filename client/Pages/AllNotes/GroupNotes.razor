@page "/notes/group/{GroupId:int}"
@using Client.Pages.Home
@using Client.Services
@inject NotesStore Store
@inject UiStrings Strings

<PageTitle>@GroupName</PageTitle>

<PrimaryHeader />

<div class="home-body">
    <Drawer UserName="@Store.Profile.Name" UserEmail="@Store.Profile.Email" />

    <div class="home-feed notes-feed">
        <a class="notes-back-link" href="/notes">
            <span aria-hidden="true">←</span> Back to All Notes
        </a>

        @if (GroupPosts.Count == 0)
        {
            <h1 class="notes-title">@GroupName</h1>
            <p class="stub-text">This group doesn't have any notes yet. Add notes to it from All Notes.</p>
        }
        else
        {
            <NotesList Title="@GroupName" Posts="GroupPosts" OnDelete="HandleDelete" OnAddToGroup="OpenAddToGroup" OnUnshare="HandleUnshare" />
        }
    </div>
</div>

<Modal IsOpen="AddToGroupModalOpen" IsOpenChanged="@(open => AddToGroupModalOpen = open)" ShowAcceptButton="false">
    <h3 class="modal-form-heading">@Strings.Get("addToGroup")</h3>
    <div class="group-picker-list">
        @foreach (var group in Store.Groups)
        {
            <button type="button" class="group-picker-item" @onclick="() => AssignGroup(group)" @key="group.Id">@group.Name</button>
        }
    </div>
</Modal>

@code {
    [Parameter] public int GroupId { get; set; }

    private string GroupName => Store.Groups.FirstOrDefault(g => g.Id == GroupId)?.Name ?? "";
    private List<Post> GroupPosts => Store.Posts.Where(p => p.GroupId == GroupId).ToList();

    private bool AddToGroupModalOpen { get; set; }
    private Post? PostForGroupAssignment { get; set; }

    private async Task HandleDelete(Post post) => await Store.DeletePostAsync(post);

    private async Task HandleUnshare(Post post) => await Store.UnshareAsync(post);

    private void OpenAddToGroup(Post post)
    {
        PostForGroupAssignment = post;
        AddToGroupModalOpen = true;
    }

    private async Task AssignGroup(GroupDto group)
    {
        if (PostForGroupAssignment is not null)
            await Store.SetPostGroupAsync(PostForGroupAssignment, group.Id);

        AddToGroupModalOpen = false;
    }
}
