@page "/connections"
@using Client.Pages.Home
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject ConnectionsApiClient ConnectionsApi
@inject ProfileApiClient ProfileApi
@inject UiStrings Strings

<PageTitle>@Strings.Get("connections")</PageTitle>

<PrimaryHeader />

<div class="home-body">
    <Drawer UserName="@Store.Profile.Name" UserEmail="@Store.Profile.Email" />

    <div class="home-feed">
        @if (Loading)
        {
            <div class="wizard-spinner" aria-hidden="true"></div>
        }
        else
        {
            <div class="connections-search" data-tour="connections-search">
                <SearchBar Placeholder="@Strings.Get("searchConnectionsPlaceholder")" @bind-Value="SearchTerm" />
            </div>

            <div class="connections-split">
                <div class="connections-column">
                    <h2 class="connections-column-heading">@FilteredFollowing.Count @Strings.Get("following")</h2>
                    @if (FilteredFollowing.Count == 0)
                    {
                        <p class="stub-text">@(SearchTerm.Length == 0 ? Strings.Get("noConnectionsYet") : Strings.Get("noSearchResults"))</p>
                    }
                    else
                    {
                        <div class="connections-list">
                            @foreach (var connection in FilteredFollowing)
                            {
                                <a class="connection-card" href="@($"/profile/{Uri.EscapeDataString(connection.FullName)}")" @key="connection.Id">
                                    <span class="avatar-circle" aria-hidden="true">@connection.Name.Substring(0, 1)</span>
                                    <div class="connection-info">
                                        <p class="connection-name">@connection.FullName</p>
                                        <p class="connection-role">@connection.JobTitle</p>
                                    </div>
                                    <span class="connection-arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7" />
                                            <polyline points="7 7 17 7 17 17" />
                                        </svg>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>

                <div class="connections-divider" aria-hidden="true"></div>

                <div class="connections-column">
                    <h2 class="connections-column-heading">@FilteredFollowers.Count @Strings.Get("followers")</h2>
                    @if (FilteredFollowers.Count == 0)
                    {
                        <p class="stub-text">@(SearchTerm.Length == 0 ? Strings.Get("noFollowersYet") : Strings.Get("noSearchResults"))</p>
                    }
                    else
                    {
                        <div class="connections-list">
                            @foreach (var connection in FilteredFollowers)
                            {
                                <a class="connection-card" href="@($"/profile/{Uri.EscapeDataString(connection.FullName)}")" @key="connection.Id">
                                    <span class="avatar-circle" aria-hidden="true">@connection.Name.Substring(0, 1)</span>
                                    <div class="connection-info">
                                        <p class="connection-name">@connection.FullName</p>
                                        <p class="connection-role">@connection.JobTitle</p>
                                    </div>
                                    <span class="connection-arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7" />
                                            <polyline points="7 7 17 7 17 17" />
                                        </svg>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <TourGuide TourId="connections" />
        }
    </div>
</div>

@code {
    private List<ConnectionDto> Following { get; set; } = [];
    private List<ConnectionDto> Followers { get; set; } = [];
    private bool Loading = true;
    private string SearchTerm = "";

    private List<ConnectionDto> FilteredFollowing =>
        Following.Where(c => SearchTerm.Length == 0 || c.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private List<ConnectionDto> FilteredFollowers =>
        Followers.Where(c => SearchTerm.Length == 0 || c.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        Following = await ConnectionsApi.GetMineAsync();
        Followers = AuthState.CurrentUser is { } user ? await ProfileApi.GetFollowersByIdAsync(user.Id) : [];
        Loading = false;
    }
}
