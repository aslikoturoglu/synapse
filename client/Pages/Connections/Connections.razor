@page "/connections"
@using Client.Pages.Home
@inject NotesStore Store
@inject UiStrings Strings

<PageTitle>@Strings.Get("connections")</PageTitle>

<PrimaryHeader />

<div class="home-body">
    <Drawer UserName="@Store.Profile.Name" UserEmail="@Store.Profile.Email" />

    <div class="home-feed">
        <h2 class="stub-heading">@Strings.Get("connections")</h2>
        <p class="stub-text">People you follow and who follow you will be listed here. @Strings.Get("comingSoon")</p>
    </div>
</div>
