@using Client.Pages.Home
@inject NotesStore Store
@inject UiStrings Strings

<h2 class="wizard-heading">@string.Format(Strings.Get("finalizingHeading"), Store.Draft.Title)</h2>
<p class="wizard-subtext">@Strings.Get("finalizingNotified")</p>
<p class="wizard-subtext">@Strings.Get("finalizingCheckMailPrefix") <em>@Store.Profile.Email</em> @Strings.Get("finalizingCheckMailSuffix")</p>

@code {
    [Parameter] public EventCallback OnComplete { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(2000);
        await OnComplete.InvokeAsync();
    }
}
