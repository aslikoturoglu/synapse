@using Client.Pages.Home
@using Client.Services
@inject AiApiClient AiApi
@inject UiStrings Strings

@if (NoFiles)
{
    <h2 class="wizard-heading">@Strings.Get("noFilesToGenerate")</h2>
    <button type="button" class="wizard-continue-btn" @onclick="() => OnBack.InvokeAsync()">@Strings.Get("backToUpload")</button>
}
else if (Failed)
{
    <h2 class="wizard-heading">@Strings.Get("generationFailed")</h2>
    <button type="button" class="wizard-continue-btn" @onclick="Start">@Strings.Get("retry")</button>
}
else if (Loading)
{
    <h2 class="wizard-heading">@Strings.Get("creatingSynapses")</h2>
    <DinoGame Compact="true" />
    @if (Ready)
    {
        <div class="wizard-ready-banner">
            <p>@Strings.Get("nextStepReady")</p>
            <button type="button" class="wizard-continue-btn" @onclick="ConfirmReady">@Strings.Get("continue")</button>
        </div>
    }
}
else
{
    <h2 class="wizard-heading">@Strings.Get("intakeHeading")</h2>

    <div class="wizard-describe-box">
        <textarea class="wizard-describe-input" placeholder="@Strings.Get("intakeNotesPlaceholder")" @bind="Draft.UserNotes" @bind:event="oninput"></textarea>
    </div>

    <div class="form-group">
        <label class="form-label">@Strings.Get("intakeFormatLabel")</label>
        <div class="wizard-orchestrator-menu">
            @foreach (var (value, labelKey) in FormatOptions)
            {
                <label class="wizard-orchestrator-item">
                    <input type="radio" name="format-preference" checked="@(Draft.FormatPreference == value)" @onchange="() => Draft.FormatPreference = value" />
                    <span>@Strings.Get(labelKey)</span>
                </label>
            }
        </div>
    </div>

    <button type="button" class="wizard-continue-btn" disabled="@string.IsNullOrWhiteSpace(Draft.FormatPreference)" @onclick="() => OnContinue.InvokeAsync()">@Strings.Get("continue")</button>
}

@code {
    // Values sent as-is to the server, which forwards them verbatim to orchestrator-chat-
    // agent-synapse — it maps them into synthesis_mode itself, per its own "no technical
    // jargon to the user" constraint, so these stay plain English rather than the raw enum.
    private static readonly (string Value, string LabelKey)[] FormatOptions =
    [
        ("Bulleted Breakdown", "formatBulleted"),
        ("Narrative Explanation", "formatNarrative"),
        ("Summary", "formatSummary"),
    ];

    [Parameter, EditorRequired] public NoteDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool Loading = true;
    private bool Ready;
    private bool Failed;
    private bool NoFiles;

    protected override async Task OnInitializedAsync()
    {
        // Already started (e.g. resuming a draft) — don't re-upload the files or restart the
        // conversation, just show what's already there.
        if (Draft.OrchestratorThreadId is null)
            await Start();
        else
            Loading = false;
    }

    private async Task Start()
    {
        Loading = true;
        Ready = false;
        Failed = false;
        NoFiles = false;

        // A draft can reach here with no files attached — most often a stuck earlier attempt
        // (Retry would otherwise just resend the same empty request forever, since nothing
        // here re-uploads). Route back to Upload instead of wasting a round-trip on a request
        // the server always rejects with 400.
        if (Draft.Files.Count == 0)
        {
            NoFiles = true;
            Loading = false;
            return;
        }

        var files = Draft.Files.Select(f => (f.Name, f.Bytes)).ToList();
        var response = await AiApi.StartAsync(files, description: "");
        if (response is null)
        {
            Failed = true;
            Loading = false;
            return;
        }

        Draft.OrchestratorThreadId = response.ThreadId;
        Draft.FoundryFileIds.Clear();
        Draft.FoundryFileIds.AddRange(response.FileIds);
        Draft.PreliminaryKeywords.Clear();
        Draft.PreliminaryKeywords.AddRange(response.PreliminaryScan.SeedKeywords);
        Draft.PreliminaryClassification = response.PreliminaryScan;
        Draft.DocumentKnowledgeBase = response.DocumentKnowledgeBase;
        Draft.DraftGraph = response.DraftGraph;

        Ready = true;
    }

    // Only fired by the wizard-ready-banner button — keeps the game on screen, uninterrupted,
    // for as long as the user wants once the AI call finishes instead of yanking the form up
    // the instant it's technically ready.
    private void ConfirmReady()
    {
        Loading = false;
        Ready = false;
    }
}
