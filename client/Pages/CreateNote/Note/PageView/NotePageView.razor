@using Client.Pages.CreateNote
@using Client.Pages.Home
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="note-file-page-surface">
    @if (!string.IsNullOrWhiteSpace(Page.Heading))
    {
        <p class="note-file-page-title" @key="Page.Heading" @ref="HeadingElement">@((MarkupString)Page.Heading)</p>
    }

    @if (EditMode)
    {
        <div class="note-file-page-body note-page-editable" contenteditable="true" @ref="BodyElement">@((MarkupString)Page.Body)</div>
    }
    else
    {
        <p class="note-file-page-body" @key="Page.Body" @ref="BodyElement">@((MarkupString)Page.Body)</p>
    }

    <p class="note-file-page-footer">@DocumentTitle | Page @Page.Number</p>
</div>

@code {
    [Parameter, EditorRequired] public NotePage Page { get; set; } = null!;
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public string DocumentTitle { get; set; } = "";

    // When set, selecting text inside this page (without pressing any button) fires
    // OnTextSelected — used by Ask AI mode's single page, where there's no toolbar to click.
    [Parameter] public bool EnableSelectionListener { get; set; }
    [Parameter] public EventCallback OnTextSelected { get; set; }

    private ElementReference BodyElement;
    private ElementReference HeadingElement;
    private DotNetObjectReference<NotePageView>? _selfRef;

    // Which element the most recent selection-driven bubble (HandleAutoAsk) came from — set by
    // whichever Notify* method JS invoked, read right after by NotePagesViewer via
    // LastSelectionTargetsHeading before it creates the highlight.
    private bool _lastSelectionWasHeading;
    private ElementReference SelectionElement => _lastSelectionWasHeading ? HeadingElement : BodyElement;

    public bool LastSelectionTargetsHeading => _lastSelectionWasHeading;

    // Not gated on firstRender: applying a highlight changes Page.Body/Heading, and since
    // those elements are keyed on that same value, Blazor throws the exact DOM node away and
    // mounts a new one — the JS listener attached to the old node goes with it, so this needs
    // to run again on every render for the new node to pick one up. noteEditor.onSelectionMade
    // guards against double-attaching to a node that already has a listener.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (EnableSelectionListener && !EditMode)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("noteEditor.onSelectionMade", BodyElement, _selfRef, "NotifyTextSelected");
            if (!string.IsNullOrWhiteSpace(Page.Heading))
                await JS.InvokeVoidAsync("noteEditor.onSelectionMade", HeadingElement, _selfRef, "NotifyHeadingTextSelected");
        }
    }

    [JSInvokable]
    public Task NotifyTextSelected()
    {
        _lastSelectionWasHeading = false;
        return OnTextSelected.InvokeAsync();
    }

    [JSInvokable]
    public Task NotifyHeadingTextSelected()
    {
        _lastSelectionWasHeading = true;
        return OnTextSelected.InvokeAsync();
    }

    public ValueTask<string> GetEditedHtmlAsync() =>
        JS.InvokeAsync<string>("noteEditor.getHtml", BodyElement);

    public ValueTask<string> GetSelectionTextAsync() =>
        JS.InvokeAsync<string>("noteEditor.getSelectionText", SelectionElement);

    public async Task ApplyHighlightAsync(Guid highlightId, bool targetsHeading)
    {
        if (targetsHeading)
            Page.Heading = await JS.InvokeAsync<string>("noteEditor.wrapSelectionAsHighlight", HeadingElement, highlightId.ToString());
        else
            Page.Body = await JS.InvokeAsync<string>("noteEditor.wrapSelectionAsHighlight", BodyElement, highlightId.ToString());
    }

    public ValueTask ScrollToHighlightAsync(Guid highlightId, bool targetsHeading) =>
        JS.InvokeVoidAsync("noteEditor.scrollToHighlight", targetsHeading ? HeadingElement : BodyElement, highlightId.ToString());

    // "Add to Document": either inserts the given html right after the highlighted span
    // (replace: false) or swaps the highlighted span out for it entirely (replace: true).
    public async Task ApplyDocumentEditAsync(Guid highlightId, string html, bool replace, bool targetsHeading)
    {
        if (targetsHeading)
            Page.Heading = await JS.InvokeAsync<string>("noteEditor.applyDocumentEdit", HeadingElement, highlightId.ToString(), html, replace);
        else
            Page.Body = await JS.InvokeAsync<string>("noteEditor.applyDocumentEdit", BodyElement, highlightId.ToString(), html, replace);
    }

    // One or more formatting instructions ("make this red and bold") from the Ask AI chat:
    // applied together, directly to the highlighted span in a single pass, not via the agent's
    // answer text — see NoteFormatCommand. Combined into one space-separated class list rather
    // than one JS call per command: the first call would replace the <mark> with a plain
    // <span> (see noteEditor.js), so a second call wouldn't find it anymore. CSS classes are
    // resolved here (not in JS) so noteEditor.js stays a generic "wrap the mark in a span with
    // these classes" primitive.
    public async Task ApplyFormatCommandsAsync(Guid highlightId, IReadOnlyList<NoteFormatCommand> commands, bool targetsHeading)
    {
        var cssClass = string.Join(' ', commands.Select(CssClassFor));

        if (targetsHeading)
            Page.Heading = await JS.InvokeAsync<string>("noteEditor.applyFormatCommand", HeadingElement, highlightId.ToString(), cssClass);
        else
            Page.Body = await JS.InvokeAsync<string>("noteEditor.applyFormatCommand", BodyElement, highlightId.ToString(), cssClass);
    }

    private static string CssClassFor(NoteFormatCommand command) => command switch
    {
        NoteFormatCommand.Subtitle => "note-format-subtitle",
        NoteFormatCommand.Heading => "note-format-heading",
        NoteFormatCommand.TextRed => "note-format-red",
        NoteFormatCommand.HighlightPink => "note-format-highlight-pink",
        NoteFormatCommand.HighlightBlue => "note-format-highlight-blue",
        NoteFormatCommand.HighlightGreen => "note-format-highlight-green",
        NoteFormatCommand.Bold => "note-format-bold",
        NoteFormatCommand.Enlarge => "note-format-large",
        _ => throw new ArgumentOutOfRangeException(nameof(command)),
    };

    // Dismissing a bubble: keeps the text but strips the <mark> wrapper (and thus the
    // highlight styling) out of the persisted page content for good.
    public async Task RemoveHighlightAsync(Guid highlightId, bool targetsHeading)
    {
        if (targetsHeading)
            Page.Heading = await JS.InvokeAsync<string>("noteEditor.removeHighlight", HeadingElement, highlightId.ToString());
        else
            Page.Body = await JS.InvokeAsync<string>("noteEditor.removeHighlight", BodyElement, highlightId.ToString());
    }

    public ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
