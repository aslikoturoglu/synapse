@using Client.Pages.CreateNote
@inject UiStrings Strings

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" ShowAcceptButton="false">
    <h3 class="modal-form-heading">@Strings.Get("lookAtTopics")</h3>
    <div class="group-picker-list">
        @foreach (var notePage in Pages.Where(p => !string.IsNullOrWhiteSpace(p.Heading)))
        {
            <button type="button" class="group-picker-item" @onclick="() => SelectPage(notePage.Number)">@notePage.Heading</button>
        }
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter, EditorRequired] public List<NotePage> Pages { get; set; } = [];
    [Parameter] public EventCallback<int> OnSelectPage { get; set; }

    private async Task SelectPage(int number)
    {
        await OnSelectPage.InvokeAsync(number);
        await IsOpenChanged.InvokeAsync(false);
    }
}
