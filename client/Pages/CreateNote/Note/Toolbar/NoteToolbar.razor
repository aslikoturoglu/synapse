@inject IJSRuntime JS
@inject UiStrings Strings

<div class="note-toolbar">
    @if (!EditMode)
    {
        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("askToAi")" aria-label="@Strings.Get("askToAi")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("changeByHand")" aria-label="@Strings.Get("changeByHand")" @onclick="OnToggleEdit">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("download")" aria-label="@Strings.Get("download")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("sendByEmail")" aria-label="@Strings.Get("sendByEmail")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("shareOnProfile")" aria-label="@Strings.Get("shareOnProfile")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("lookAtTopics")" aria-label="@Strings.Get("lookAtTopics")" @onclick="OnShowToc">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
        </button>
    }
    else
    {
        <button type="button" class="note-toolbar-icon note-toolbar-icon-active" data-tooltip="@Strings.Get("changeByHand")" aria-label="@Strings.Get("changeByHand")">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
        </button>

        <div class="note-toolbar-divider"></div>

        <button type="button" class="note-toolbar-icon note-toolbar-text-icon" data-tooltip="Heading" aria-label="Heading" @onmousedown:preventDefault="true" @onclick='() => Exec("formatBlock", "H3")'>T</button>
        <button type="button" class="note-toolbar-icon note-toolbar-text-icon" data-tooltip="Bold" aria-label="Bold" @onmousedown:preventDefault="true" @onclick='() => Exec("bold")'><strong>B</strong></button>
        <button type="button" class="note-toolbar-icon note-toolbar-text-icon" data-tooltip="Italic" aria-label="Italic" @onmousedown:preventDefault="true" @onclick='() => Exec("italic")'><em>I</em></button>
        <button type="button" class="note-toolbar-icon note-toolbar-text-icon" data-tooltip="Underline" aria-label="Underline" @onmousedown:preventDefault="true" @onclick='() => Exec("underline")'><u>U</u></button>

        <div class="note-toolbar-divider"></div>

        <button type="button" class="note-toolbar-icon" data-tooltip="Copy" aria-label="Copy" @onmousedown:preventDefault="true" @onclick='() => Exec("copy")'>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="More" aria-label="More">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" stroke="none"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="Align left" aria-label="Align left" @onmousedown:preventDefault="true" @onclick='() => Exec("justifyLeft")'>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="15" y2="12" /><line x1="3" y1="18" x2="18" y2="18" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="Align center" aria-label="Align center" @onmousedown:preventDefault="true" @onclick='() => Exec("justifyCenter")'>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="6" y1="12" x2="18" y2="12" /><line x1="4" y1="18" x2="20" y2="18" /></svg>
        </button>

        <button type="button" class="note-toolbar-icon" data-tooltip="Align right" aria-label="Align right" @onmousedown:preventDefault="true" @onclick='() => Exec("justifyRight")'>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="9" y1="12" x2="21" y2="12" /><line x1="6" y1="18" x2="21" y2="18" /></svg>
        </button>

        <div class="note-toolbar-divider"></div>

        <button type="button" class="note-toolbar-icon" data-tooltip="@Strings.Get("lookAtTopics")" aria-label="@Strings.Get("lookAtTopics")" @onclick="OnShowToc">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
        </button>

        <button type="button" class="btn-primary note-toolbar-done" @onclick="OnDone">@Strings.Get("done")</button>
    }
</div>

@code {
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public EventCallback OnToggleEdit { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }
    [Parameter] public EventCallback OnShowToc { get; set; }

    private ValueTask Exec(string command, string? value = null) =>
        JS.InvokeVoidAsync("noteEditor.exec", command, value);
}
