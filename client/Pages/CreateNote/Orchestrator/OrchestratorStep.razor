@using Client.Pages.Home
@using Client.Services
@inject AiApiClient AiApi
@inject UiStrings Strings

@if (Loading)
{
    <h2 class="wizard-heading">@Strings.Get("creatingSynapses")</h2>
    <div class="wizard-spinner" aria-hidden="true"></div>
}
else
{
    <p class="wizard-orchestrator-summary">@Draft.OrchestratorSummary</p>

    <div class="wizard-orchestrator-menu">
        @for (var i = 0; i < MenuItems.Length; i++)
        {
            var number = i + 1;
            var label = MenuItems[i];
            <label class="wizard-orchestrator-item">
                <input type="checkbox" checked="@Draft.SelectedMenuNumbers.Contains(number)" @onchange="e => ToggleMenuItem(number, (bool)e.Value!)" />
                <span>@number. @label</span>
            </label>
        }
    </div>

    <button type="button" class="wizard-continue-btn" disabled="@(Draft.SelectedMenuNumbers.Count == 0 || Submitting)" @onclick="SubmitSelection">
        @Strings.Get("continue")
    </button>
}

@code {
    // Fixed per orchestrator-chat-agent-synapse's own strict spec — it always presents
    // exactly these 5 items, so they're rendered directly rather than parsed from its text.
    private static readonly string[] MenuItems =
    [
        "Executive Summary",
        "Bulleted Breakdown by Lecture/Topic",
        "Cross-Cutting Themes & Tensions",
        "Key Examples & Thought Experiments",
        "Critical Questions & Discussion Prompts",
    ];

    [Parameter, EditorRequired] public NoteDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnContinue { get; set; }

    private bool Loading = true;
    private bool Submitting;

    protected override async Task OnInitializedAsync()
    {
        // Already started (e.g. resuming a draft) — don't re-upload the files or restart the
        // conversation, just show what's already there.
        if (Draft.OrchestratorThreadId is null)
        {
            var files = Draft.Files.Select(f => (f.Name, f.Bytes)).ToList();
            var response = await AiApi.StartOrchestratorAsync(files, Draft.Description);
            if (response is not null)
            {
                Draft.OrchestratorThreadId = response.ThreadId;
                Draft.OrchestratorSummary = response.Summary;
                Draft.FoundryFileIds.Clear();
                Draft.FoundryFileIds.AddRange(response.FileIds);
            }
        }

        Loading = false;
    }

    private void ToggleMenuItem(int number, bool isChecked)
    {
        if (isChecked)
        {
            if (!Draft.SelectedMenuNumbers.Contains(number))
                Draft.SelectedMenuNumbers.Add(number);
        }
        else
        {
            Draft.SelectedMenuNumbers.Remove(number);
        }
    }

    private async Task SubmitSelection()
    {
        if (Draft.OrchestratorThreadId is null || Submitting)
            return;

        Submitting = true;

        var selection = string.Join(", ", Draft.SelectedMenuNumbers.OrderBy(n => n));
        var directive = await AiApi.SelectOrchestratorMenuAsync(Draft.OrchestratorThreadId, selection);
        if (directive is not null)
        {
            Draft.Directive = new NoteAiDirective
            {
                SeedKeywords = directive.SeedKeywords,
                FocusAreas = directive.FocusAreas,
                SynthesisMode = directive.SynthesisMode,
                UserCustomInstructions = directive.UserCustomInstructions,
            };
            await OnContinue.InvokeAsync();
        }

        Submitting = false;
    }
}
