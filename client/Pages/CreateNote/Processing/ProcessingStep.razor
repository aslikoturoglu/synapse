@using Client.Pages.Home
@using Client.Services
@inject AiApiClient AiApi
@inject UiStrings Strings

@if (Failed)
{
    <h2 class="wizard-heading">@Strings.Get("generationFailed")</h2>
    <button type="button" class="wizard-continue-btn" @onclick="Generate">@Strings.Get("retry")</button>
}
else
{
    <h2 class="wizard-heading">@Strings.Get("creatingSynapses")</h2>
    <div class="wizard-spinner" aria-hidden="true"></div>
}

@code {
    [Parameter, EditorRequired] public NoteDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnComplete { get; set; }

    private bool Failed;

    protected override Task OnInitializedAsync() => Generate();

    // topic-synthesizer-agent-synapse runs first (via the Orchestrator's synthesis_mode
    // mapping), then brain-map-agent-synapse's final mode enriches the draft map using the
    // now-finished document. Each half is independently idempotent — a retry after the note
    // succeeded but the final map failed only redoes the map, not the whole document.
    private async Task Generate()
    {
        Failed = false;

        if (Draft.OrchestratorThreadId is null || Draft.DocumentKnowledgeBase is null)
        {
            Failed = true;
            return;
        }

        if (Draft.Pages.Count == 0)
        {
            var finalKeywords = Draft.Keywords.Where(k => k.Status != KeywordStatus.AiDeleted).Select(k => k.Text).ToList();
            var noteResponse = await AiApi.GenerateNoteAsync(new GenerateNoteRequest
            {
                ThreadId = Draft.OrchestratorThreadId,
                DocumentKnowledgeBase = Draft.DocumentKnowledgeBase,
                FormatPreference = Draft.FormatPreference,
                UserNotes = Draft.UserNotes,
                FinalKeywords = finalKeywords,
                PreliminaryClassification = Draft.PreliminaryClassification ?? new PreliminaryScanDto(),
            });

            if (noteResponse is null)
            {
                Failed = true;
                return;
            }

            Draft.Pages.AddRange(noteResponse.Pages.Select(p => new NotePage { Number = p.Number, Heading = p.Heading, Body = p.Body }));
            Draft.SynthesizedMarkdown = noteResponse.SynthesizedMarkdown;
        }

        if (Draft.FinalGraph is null && Draft.SynthesizedMarkdown is not null)
        {
            var draftKeywords = Draft.Keywords.Where(k => k.Status != KeywordStatus.AiDeleted).Select(k => k.Text).ToList();
            var finalGraph = await AiApi.GenerateFinalBrainMapAsync(new GenerateFinalBrainMapRequest
            {
                DraftKeywords = draftKeywords,
                SynthesizedMarkdown = Draft.SynthesizedMarkdown,
                DocumentKnowledgeBase = Draft.DocumentKnowledgeBase,
            });

            if (finalGraph is null)
            {
                Failed = true;
                return;
            }

            Draft.FinalGraph = finalGraph;
        }

        await OnComplete.InvokeAsync();
    }
}
