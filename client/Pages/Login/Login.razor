@page "/login"
@inject NavigationManager Navigation

<PageTitle>Log In</PageTitle>

<div class="auth-page">
    <h1 class="brand-title">synapse.</h1>

    <div class="auth-card">
        <EditForm Model="this" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label class="form-label" for="login-identifier">Username / Email Address</label>
                <InputText id="login-identifier" class="form-input" placeholder="you@example.com" @bind-Value="UsernameOrEmail" />
            </div>

            <div class="form-group">
                <label class="form-label" for="login-password">Password</label>
                <InputText id="login-password" type="password" class="form-input" placeholder="Enter your password" @bind-Value="Password" />
            </div>

            <button type="submit" class="btn-primary btn-block">Log In</button>
        </EditForm>
    </div>

    <div class="auth-card">
        <p class="card-heading">Forgot Password?</p>

        <EditForm Model="this" OnValidSubmit="HandleResetPassword">
            <div class="form-group">
                <label class="form-label" for="reset-email">Email Address</label>
                <InputText id="reset-email" class="form-input" placeholder="you@example.com" @bind-Value="ResetEmail" />
            </div>

            <button type="submit" class="btn-primary btn-block">Reset Password</button>
        </EditForm>
    </div>

    <BackLink />
</div>

@code {
    private string UsernameOrEmail { get; set; } = "";
    private string Password { get; set; } = "";
    private string ResetEmail { get; set; } = "";

    private void HandleLogin()
    {
        // No backend auth yet — treat a submitted login form as successful for now.
        Navigation.NavigateTo("/home");
    }

    private void HandleResetPassword()
    {
    }
}
