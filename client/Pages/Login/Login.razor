@page "/login"
@using Client.Pages.Home
@using Client.Services
@inject NavigationManager Navigation
@inject UiStrings Strings
@inject AuthApiClient AuthApi
@inject AuthState AuthState
@inject NotesStore Store

<PageTitle>@Strings.Get("logIn")</PageTitle>

<div class="auth-page">
    <h1 class="brand-title">synapse.</h1>

    <div class="auth-card">
        <EditForm Model="this" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label class="form-label" for="login-identifier">@Strings.Get("usernameOrEmailAddress")</label>
                <InputText id="login-identifier" class="form-input" placeholder="@Strings.Get("emailPlaceholder")" @bind-Value="UsernameOrEmail" />
            </div>

            <div class="form-group">
                <div class="form-label-row">
                    <label class="form-label" for="login-password">@Strings.Get("password")</label>
                    <button type="button" class="link-inline" @onclick="OpenForgotPassword">@Strings.Get("forgotPassword")</button>
                </div>
                <InputText id="login-password" type="password" class="form-input" placeholder="@Strings.Get("passwordPlaceholder")" @bind-Value="Password" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="field-error">@ErrorMessage</p>
            }

            <button type="submit" class="btn-primary btn-block @(IsSubmitting ? "btn-disabled-look" : "")" disabled="@IsSubmitting">@Strings.Get("logIn")</button>
        </EditForm>
    </div>

    <BackLink />
</div>

<Modal IsOpen="ForgotPasswordModalOpen" IsOpenChanged="@(open => ForgotPasswordModalOpen = open)" ShowAcceptButton="false">
    <h3 class="modal-form-heading">@Strings.Get("forgotPassword")</h3>

    @if (!ResetLinkSent)
    {
        <p class="stub-text">@Strings.Get("resetPasswordIntro")</p>

        <EditForm Model="this" OnValidSubmit="HandleResetPassword">
            <div class="form-group">
                <label class="form-label" for="reset-email">@Strings.Get("emailAddress")</label>
                <InputText id="reset-email" class="form-input" placeholder="@Strings.Get("emailPlaceholder")" @bind-Value="ResetEmail" />
            </div>

            @if (!string.IsNullOrEmpty(ResetErrorMessage))
            {
                <p class="field-error">@ResetErrorMessage</p>
            }

            <button type="submit" class="btn-primary btn-block @(IsResetSubmitting ? "btn-disabled-look" : "")" disabled="@IsResetSubmitting">@Strings.Get("resetPassword")</button>
        </EditForm>
    }
    else
    {
        <p class="stub-text">@Strings.Get("resetLinkSentNote") <strong>@ResetEmail</strong></p>
    }
</Modal>

@code {
    private string UsernameOrEmail { get; set; } = "";
    private string Password { get; set; } = "";
    private string ResetEmail { get; set; } = "";

    private string? ErrorMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private bool ForgotPasswordModalOpen { get; set; }
    private bool ResetLinkSent { get; set; }
    private bool IsResetSubmitting { get; set; }
    private string? ResetErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        IsSubmitting = true;

        var result = await AuthApi.LoginAsync(new LoginRequest
        {
            UsernameOrEmail = UsernameOrEmail.Trim(),
            Password = Password,
        });

        IsSubmitting = false;

        if (!result.Succeeded || result.Response is null)
        {
            ErrorMessage = result.Error ?? "Something went wrong. Please try again.";
            return;
        }

        await AuthState.SetSessionAsync(result.Response);
        Store.ApplyAuthUser(result.Response.User);
        await Store.LoadFeedAsync();
        await Store.LoadGroupsAsync();

        Navigation.NavigateTo("/home");
    }

    private void OpenForgotPassword()
    {
        ResetEmail = "";
        ResetLinkSent = false;
        ResetErrorMessage = null;
        ForgotPasswordModalOpen = true;
    }

    private async Task HandleResetPassword()
    {
        ResetErrorMessage = null;
        IsResetSubmitting = true;

        var succeeded = await AuthApi.ForgotPasswordAsync(ResetEmail.Trim());

        IsResetSubmitting = false;

        if (!succeeded)
        {
            ResetErrorMessage = "Could not reach the server. Please try again.";
            return;
        }

        ResetLinkSent = true;
    }
}
