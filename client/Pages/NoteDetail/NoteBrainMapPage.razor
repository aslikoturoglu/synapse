@page "/notes/{PostId:int}/brain-map"
@using Client.Pages.Home
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject UiStrings Strings

<PageTitle>@(Post?.Title ?? Strings.Get("allNotes"))</PageTitle>

@if (Post is null)
{
    <p class="stub-text">@Strings.Get("noPostsYet")</p>
}
else
{
    <NoteDetailLayout Post="Post">
        @if (Post.Keywords.Count == 0)
        {
            <p class="stub-text">@Strings.Get("noKeywordsYet")</p>
        }
        else
        {
            @* Non-owner viewers only ever see the Brain Map's final state — no AI-deleted/
               user-added history markers, no add/remove controls (ShowHistory/ReadOnly below
               both key off IsAuthor). *@
            <BrainMapDiagram Keywords="Post.Keywords" ShowHistory="@IsAuthor" AlwaysEditable="true" ReadOnly="@(!IsAuthor)" OnAdd="AddKeyword" OnRemove="RemoveKeyword">
                @if (IsAuthor)
                {
                    <div class="brain-map-history-summary">
                        <span><strong>@Post.Keywords.Count</strong> @Strings.Get("keywordsTotalLabel")</span>
                        <span><strong>@GeneratedCount</strong> @Strings.Get("keywordsGeneratedLabel")</span>
                        <span><strong>@DeletedCount</strong> @Strings.Get("keywordsDeletedLabel")</span>
                        <span><strong>@AddedCount</strong> @Strings.Get("keywordsAddedLabel")</span>
                    </div>
                }
            </BrainMapDiagram>
        }
    </NoteDetailLayout>
}

@code {
    [Parameter] public int PostId { get; set; }

    private Post? Post;
    private int? LoadedPostId;

    private bool IsAuthor => Post?.AuthorId == AuthState.CurrentUser?.Id;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedPostId == PostId)
            return;

        LoadedPostId = PostId;
        Post = await Store.LoadPostDetailAsync(PostId);
    }

    private int GeneratedCount => Post?.Keywords.Count(k => k.Status != KeywordStatus.UserAdded) ?? 0;
    private int DeletedCount => Post?.Keywords.Count(k => k.Status == KeywordStatus.AiDeleted) ?? 0;
    private int AddedCount => Post?.Keywords.Count(k => k.Status == KeywordStatus.UserAdded) ?? 0;

    private async Task RemoveKeyword(BrainMapKeyword keyword)
    {
        if (Post is not null)
            await Store.RemoveKeywordAsync(Post, keyword);
    }

    private async Task AddKeyword(string text)
    {
        if (Post is not null)
            await Store.AddKeywordAsync(Post, text);
    }
}
