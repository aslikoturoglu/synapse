@page "/notes/{PostId:int}/process"
@using Client.Pages.Home
@using Client.Pages.NoteDetail.Process
@using Client.Pages.CreateNote.Note.PageView
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject UiStrings Strings

<PageTitle>@(Post?.Title ?? Strings.Get("allNotes"))</PageTitle>

@if (Post is null)
{
    <p class="stub-text">@Strings.Get("noPostsYet")</p>
}
else
{
    <NoteDetailLayout Post="Post">
        @if (Post.Pages.Count == 0)
        {
            <p class="stub-text">@Strings.Get("noGeneratedNoteYet")</p>
        }
        else
        {
            <div class="process-columns">
                <ProcessSummaryPanel Post="Post" SelectedHighlightId="SelectedHighlightId" OnSelect="SelectHighlight" />
                <ProcessChatPanel Post="Post" SelectedHighlightId="SelectedHighlightId" ReadOnly="@(!IsAuthor)" OnFollowUpAsked="HandleFollowUpAsked" />

                <div class="process-document-column">
                    <NotePageView @ref="PageView" Page="CurrentPage" EditMode="false" DocumentTitle="@Post.Title" />

                    <NotePagination Total="Post.Pages.Count" Current="CurrentPageNumber" OnSelect="GoToPage" />
                </div>
            </div>
        }
    </NoteDetailLayout>
}

@code {
    [Parameter] public int PostId { get; set; }

    private Post? Post;
    private int? LoadedPostId;
    private int CurrentPageNumber = 1;
    private Guid? SelectedHighlightId;
    private Guid? PendingScrollHighlightId;

    private NotePageView? PageView;

    private bool IsAuthor => Post?.AuthorId == AuthState.CurrentUser?.Id;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedPostId == PostId)
            return;

        LoadedPostId = PostId;
        Post = await Store.LoadPostDetailAsync(PostId);
    }

    private async Task HandleFollowUpAsked((Guid HighlightId, AiChatMessage Message) args)
    {
        if (Post is not null)
            await Store.AddHighlightMessageAsync(Post, args.HighlightId, args.Message);
    }

    private NotePage CurrentPage => Post!.Pages[CurrentPageNumber - 1];

    private void GoToPage(int pageNumber) => CurrentPageNumber = pageNumber;

    private void SelectHighlight(Guid highlightId)
    {
        SelectedHighlightId = highlightId;
        var highlight = Post!.Highlights.FirstOrDefault(h => h.Id == highlightId);
        if (highlight is not null)
            CurrentPageNumber = highlight.PageNumber;

        PendingScrollHighlightId = highlightId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (PendingScrollHighlightId is { } id && PageView is not null)
        {
            PendingScrollHighlightId = null;
            var targetsHeading = Post!.Highlights.FirstOrDefault(h => h.Id == id)?.TargetsHeading ?? false;
            await PageView.ScrollToHighlightAsync(id, targetsHeading);
        }
    }
}
