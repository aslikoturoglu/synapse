@page "/notes/{PostId:int}"
@using Client.Pages.Home
@using Client.Pages.CreateNote.Note.PageView
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject UiStrings Strings

<PageTitle>@(Post?.Title ?? Strings.Get("allNotes"))</PageTitle>

@if (Post is null)
{
    <p class="stub-text">@Strings.Get("noPostsYet")</p>
}
else if (ShowAllPages)
{
    <NoteDetailLayout Post="Post" ShowBackActions="false">
        <button type="button" class="back-link back-link-right" data-floating-widget @onclick="() => ShowAllPages = false">
            <span aria-hidden="true">←</span>
            <span>@Strings.Get("back")</span>
        </button>
        <NotePagesViewer Pages="Post.Pages" Title="@Post.Title" PostId="Post.Id" Highlights="Post.Highlights" Posted="Post.IsShared" IsAuthor="IsAuthor"
                         OnShare="() => ShareModalOpen = true" OnDocumentChanged="HandleDocumentChanged"
                         OnPageBodyChanged="HandlePageBodyChanged" OnPageHeadingChanged="HandlePageHeadingChanged"
                         OnHighlightCreated="HandleHighlightCreated" OnHighlightMessageAdded="HandleHighlightMessageAdded"
                         OnHighlightAddedToDocument="HandleHighlightAddedToDocument"
                         PersonalNotes="Post.PersonalNotes" OnPersonalNotesChanged="HandlePersonalNotesChanged" />
    </NoteDetailLayout>
}
else
{
    <NoteDetailLayout Post="Post" ShowBackActions="false">
        @if (Post.Pages.Count == 0)
        {
            <p class="stub-text">@Strings.Get("noGeneratedNoteYet")</p>
        }
        else
        {
            <div class="note-reader-cover" data-tooltip="@Strings.Get("tapToSeeAllPages")" aria-label="@Strings.Get("tapToSeeAllPages")" @onclick="() => ShowAllPages = true">
                <div class="note-reader-cover-card">
                    <div class="note-reader-cover-page">
                        <NotePageView Page="Post.Pages[0]" EditMode="false" DocumentTitle="@Post.Title" />
                    </div>
                </div>
            </div>
        }

        <div class="note-reader-actions-row">
            @if (IsAuthor || Post.ShareBrainMap)
            {
                <button type="button" class="btn-primary note-reader-nav-btn" @onclick='() => Navigation.NavigateTo($"/notes/{Post.Id}/brain-map")'>@Strings.Get("brainMapButton")</button>
            }
            @if (IsAuthor || Post.ShareProcess)
            {
                <button type="button" class="btn-primary note-reader-nav-btn" @onclick='() => Navigation.NavigateTo($"/notes/{Post.Id}/process")'>@Strings.Get("process")</button>
            }
            @* Map has no share toggle — always open to any viewer of a shared post. *@
            <button type="button" class="btn-primary note-reader-nav-btn" @onclick='() => Navigation.NavigateTo($"/notes/{Post.Id}/map")'>@Strings.Get("mapButton")</button>
        </div>
    </NoteDetailLayout>
}

@if (Post is not null)
{
    <ShareSettingsModal Post="Post" IsOpen="ShareModalOpen" IsOpenChanged="@(open => ShareModalOpen = open)" />
}

@code {
    [Parameter] public int PostId { get; set; }

    // "?view=pages" opens straight into the full Table-of-Contents/reading view instead of the
    // cover card — used by the Edit button on the Process/Brain Map/Map screens so it lands
    // exactly on the screen it looks like it should, not one extra click away from it.
    [SupplyParameterFromQuery(Name = "view")]
    [Parameter]
    public string? View { get; set; }

    private Post? Post;
    private bool ShowAllPages;
    private bool ShareModalOpen;
    private int? LoadedPostId;

    private bool IsAuthor => Post?.AuthorId == AuthState.CurrentUser?.Id;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedPostId == PostId)
            return;

        LoadedPostId = PostId;
        Post = await Store.LoadPostDetailAsync(PostId);
        ShowAllPages = View == "pages";
    }

    private async Task HandleDocumentChanged()
    {
        if (Post is not null)
            await Store.IncrementDocumentChangeAsync(Post);
    }

    private async Task HandlePageBodyChanged(NotePage page)
    {
        if (Post is not null)
            await Store.UpdatePageBodyAsync(Post, page.Number, page.Body);
    }

    private async Task HandlePersonalNotesChanged(string notes)
    {
        if (Post is not null)
            await Store.UpdatePersonalNotesAsync(Post, notes);
    }

    private async Task HandlePageHeadingChanged(NotePage page)
    {
        if (Post is not null && page.Heading is not null)
            await Store.UpdatePageHeadingAsync(Post, page.Number, page.Heading);
    }

    private async Task HandleHighlightCreated(NoteHighlight highlight)
    {
        if (Post is not null)
            await Store.CreateHighlightAsync(Post, highlight);
    }

    private async Task HandleHighlightMessageAdded((Guid HighlightId, AiChatMessage Message) args)
    {
        if (Post is not null)
            await Store.AddHighlightMessageAsync(Post, args.HighlightId, args.Message);
    }

    private async Task HandleHighlightAddedToDocument((Guid HighlightId, int MessageId) args)
    {
        if (Post is not null)
            await Store.MarkAddedToDocumentAsync(Post, args.HighlightId, args.MessageId);
    }
}
