@using Client.Pages.Home
@inject UiStrings Strings

<div class="process-chat-panel">
    @if (PageHighlights.Count == 0)
    {
        <p class="stub-text">@Strings.Get("noHighlightsYet")</p>
    }
    else
    {
        @foreach (var highlight in PageHighlights)
        {
            <div class="process-chat-item @(highlight.Id == SelectedHighlightId ? "process-chat-item-active" : "")" @key="highlight.Id">
                <button type="button" class="process-chat-item-header" @onclick="() => ToggleExpand(highlight.Id)">
                    <span>@highlight.SelectedText</span>
                    <span class="process-chat-item-caret" aria-hidden="true">@(ExpandedHighlightIds.Contains(highlight.Id) ? "▲" : "▼")</span>
                </button>

                @if (ExpandedHighlightIds.Contains(highlight.Id))
                {
                    <div class="process-chat-item-body">
                        @foreach (var message in highlight.Messages)
                        {
                            <div class="process-chat-message @(message.AddedToDocument ? "process-chat-message-added" : "")">
                                @if (message.AddedToDocument)
                                {
                                    <span class="process-chat-added-tag">@Strings.Get("addedToDocumentTag")</span>
                                }
                                <p class="process-chat-question">@message.Question</p>
                                <p class="process-chat-answer">@(string.IsNullOrEmpty(message.Answer) ? Strings.Get("askAiThinking") : message.Answer)</p>
                            </div>
                        }

                        @if (!ReadOnly)
                        {
                            <input class="form-input process-chat-followup-input" placeholder="@Strings.Get("askAiPlaceholder")"
                                   @bind="FollowUpText" @bind:event="oninput" @onkeydown="@(e => HandleFollowUpKeydown(e, highlight))" />
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public int CurrentPageNumber { get; set; }
    [Parameter] public Guid? SelectedHighlightId { get; set; }
    // A non-owner viewer can review existing highlights/Q&A history but not ask new questions.
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<(Guid HighlightId, AiChatMessage Message)> OnFollowUpAsked { get; set; }

    // Only the page currently open in the document column — this panel used to list every
    // highlight in the whole note regardless of which page you were looking at.
    private List<NoteHighlight> PageHighlights =>
        Post.Highlights.Where(h => h.PageNumber == CurrentPageNumber).ToList();

    // Each highlight gets its own independent open/closed state — was a single nullable id
    // (accordion-style, opening one silently closed whatever else was open).
    private readonly HashSet<Guid> ExpandedHighlightIds = [];
    private string FollowUpText = "";

    protected override void OnParametersSet()
    {
        if (SelectedHighlightId is { } id)
            ExpandedHighlightIds.Add(id);
    }

    private void ToggleExpand(Guid highlightId)
    {
        if (!ExpandedHighlightIds.Remove(highlightId))
            ExpandedHighlightIds.Add(highlightId);
    }

    private async Task HandleFollowUpKeydown(KeyboardEventArgs e, NoteHighlight highlight)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(FollowUpText))
            return;

        var question = FollowUpText.Trim();
        var message = new AiChatMessage { Question = question };
        highlight.Messages.Add(message);
        FollowUpText = "";
        StateHasChanged();

        await OnFollowUpAsked.InvokeAsync((highlight.Id, message));
    }
}
