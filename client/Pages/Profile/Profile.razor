@page "/profile"
@page "/profile/{AuthorName}"
@using System.Text.RegularExpressions
@using Client.Pages.Home
@using Client.Pages.AllNotes
@using Client.Pages.Signup
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject UiStrings Strings
@inject UsersApiClient UsersApi
@inject ProfileApiClient ProfileApi
@inject RequestsApiClient RequestsApi

<PageTitle>@(IsOwnProfile ? Store.Profile.FullName : DisplayName)</PageTitle>

<PrimaryHeader UserDisplayName="@DisplayName" />

<div class="home-body">
    <Drawer UserName="@Store.Profile.Name" UserEmail="@Store.Profile.Email" />

    <div class="home-feed @(ActiveTab == ProfileTab.MyNotes ? "notes-feed" : "")">
        @if (IsOwnProfile)
        {
            <nav class="profile-nav" data-tour="profile-nav">
                <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.Profile ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.Profile">@Strings.Get("profile")</button>
                @if (!AuthState.IsAdmin)
                {
                    <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.MyPosts ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.MyPosts">@Strings.Get("myPosts")</button>
                    <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.MyFavorites ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.MyFavorites">@Strings.Get("myFavorites")</button>
                    <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.MyReposts ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.MyReposts">@Strings.Get("myReposts")</button>
                    <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.MyNotes ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.MyNotes">@Strings.Get("myNotes")</button>
                }
                <button type="button" class="profile-nav-item @(ActiveTab == ProfileTab.Settings ? "profile-nav-item-active" : "")" @onclick="() => ActiveTab = ProfileTab.Settings">@Strings.Get("settings")</button>
                <button type="button" class="profile-nav-item" @onclick="HandleLogout">@Strings.Get("logOut")</button>
            </nav>

            @if (ActiveTab == ProfileTab.Profile)
            {
                <div class="profile-header">
                    <span class="avatar-circle avatar-circle-lg" aria-hidden="true">@Store.Profile.Name.Substring(0, 1)</span>

                    @if (EditingName)
                    {
                        <div class="profile-name-edit">
                            <input class="form-input" placeholder="@Strings.Get("name")" @bind="NameDraft" @bind:event="oninput" />
                            <input class="form-input" placeholder="@Strings.Get("surname")" @bind="SurnameDraft" @bind:event="oninput" />
                            <div class="field-action-row">
                                <button type="button" class="field-confirm-icon" disabled="@(!IsNameValid)" @onclick="SaveName" aria-label="Save name">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                                </button>
                                <button type="button" class="field-cancel-icon" @onclick="CancelEdit" aria-label="Cancel">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h2 class="profile-name">
                            @Store.Profile.FullName
                            <button type="button" class="profile-edit-icon" @onclick="StartEditName" aria-label="Edit name">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
                            </button>
                        </h2>
                    }
                </div>

                <div class="profile-info">
                    <div class="profile-info-row">
                        <span class="profile-info-label">@Strings.Get("email")</span>
                        <span class="profile-info-value">@Store.Profile.Email</span>
                    </div>

                    <div class="profile-info-row">
                        <button type="button" class="profile-info-edit-icon" @onclick="@(() => StartEditField("phone", Store.Profile.Phone))" aria-label="Edit phone">@PencilIcon</button>
                        <span class="profile-info-label">@Strings.Get("phone")</span>
                        @if (EditingField == "phone")
                        {
                            <input class="form-input profile-info-input" @bind="FieldDraft" @bind:event="oninput" />
                            @FieldActions("phone")
                        }
                        else
                        {
                            <span class="profile-info-value">@Store.Profile.Phone</span>
                        }
                    </div>

                    <div class="profile-info-row">
                        <button type="button" class="profile-info-edit-icon" @onclick="@(() => StartEditField("jobTitle", Store.Profile.JobTitle))" aria-label="Edit job title">@PencilIcon</button>
                        <span class="profile-info-label">@Strings.Get("jobTitle")</span>
                        @if (EditingField == "jobTitle")
                        {
                            <input class="form-input profile-info-input" @bind="FieldDraft" @bind:event="oninput" />
                            @FieldActions("jobTitle")
                        }
                        else
                        {
                            <span class="profile-info-value">@Store.Profile.JobTitle</span>
                        }
                    </div>

                    <div class="profile-info-row">
                        <button type="button" class="profile-info-edit-icon" @onclick="@(() => StartEditField("username", Store.Profile.Username))" aria-label="Edit username">@PencilIcon</button>
                        <span class="profile-info-label">@Strings.Get("username")</span>
                        @if (EditingField == "username")
                        {
                            <input class="form-input profile-info-input" @bind="FieldDraft" @bind:event="oninput" />
                            @FieldActions("username")
                        }
                        else
                        {
                            <span class="profile-info-value">@Store.Profile.Username</span>
                        }
                    </div>

                    <div class="profile-info-row">
                        <button type="button" class="profile-info-edit-icon" @onclick="@(() => StartEditField("password", Store.Profile.Password))" aria-label="Edit password">@PencilIcon</button>
                        <span class="profile-info-label">@Strings.Get("password")</span>
                        @if (EditingField == "password")
                        {
                            <PasswordInput Id="profile-password" CssClass="form-input profile-info-input" Value="@FieldDraft" ValueChanged="@(v => FieldDraft = v)" />
                            @FieldActions("password")
                        }
                        else
                        {
                            <span class="profile-info-value">•••••••</span>
                        }
                    </div>

                    <div class="profile-info-row">
                        @if (CurrentRole != "Admin")
                        {
                            <button type="button" class="profile-info-edit-icon" disabled="@(PendingRoleRequest is not null)" @onclick="OpenRoleChangeModal" aria-label="Request role change" data-tooltip="@Strings.Get("requestRoleChangeTooltip")">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><polyline points="7 23 3 19 7 15" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                            </button>
                        }
                        <span class="profile-info-label">@Strings.Get("role")</span>
                        <span class="profile-info-value">
                            @CurrentRole
                            @if (PendingRoleRequest is not null)
                            {
                                <span class="profile-role-pending">(@Strings.Get("roleChangePending"))</span>
                            }
                        </span>
                    </div>
                </div>
            }
            else if (ActiveTab == ProfileTab.MyPosts)
            {
                @if (Store.GetMyPosts().Count == 0)
                {
                    <p class="stub-text">@Strings.Get("noPostsYet")</p>
                }
                else
                {
                    @foreach (var post in Store.GetMyPosts())
                    {
                        <PostCard Post="post" ShowFollowButton="false" OnDeleted="StateHasChanged" />
                    }
                }
            }
            else if (ActiveTab == ProfileTab.MyFavorites)
            {
                <FavoritesContent />
            }
            else if (ActiveTab == ProfileTab.MyReposts)
            {
                <RepostsContent />
            }
            else if (ActiveTab == ProfileTab.MyNotes)
            {
                <AllNotesContent ShowTitle="false" />
            }
            else if (ActiveTab == ProfileTab.Settings)
            {
                <SettingsContent />
            }
        }
        else
        {
            <div class="profile-header profile-header-other">
                <span class="avatar-circle avatar-circle-lg" aria-hidden="true">@DisplayName.Substring(0, 1)</span>
                <div class="profile-header-identity">
                    <h2 class="profile-name">
                        @DisplayName
                        @if (AuthState.CanManageUsers && IsDeactivated)
                        {
                            <span class="profile-deactivated-badge">@Strings.Get("deactivated")</span>
                        }
                    </h2>
                    @if (ProfileSummary is not null)
                    {
                        <p class="profile-role">@@@ProfileSummary.Username</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(DisplayRole))
                    {
                        <p class="profile-role">@DisplayRole</p>
                    }
                </div>

                @if (ProfileSummary is not null)
                {
                    <div class="profile-header-details">
                        <div class="profile-header-detail-col">
                            <div class="profile-header-detail-row">
                                <span class="profile-info-label">@Strings.Get("jobTitle")</span>
                                <span class="profile-info-value">@ProfileSummary.JobTitle</span>
                            </div>
                            <div class="profile-header-detail-row">
                                <span class="profile-info-label">@Strings.Get("joined")</span>
                                <span class="profile-info-value">@ProfileSummary.CreatedAt.ToLocalTime().ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </div>
                        </div>
                        @if (AuthState.CanManageUsers && OtherUserDetail is not null)
                        {
                            <div class="profile-header-detail-col">
                                <div class="profile-header-detail-row">
                                    <span class="profile-info-label">@Strings.Get("email")</span>
                                    <span class="profile-info-value">@OtherUserDetail.Email</span>
                                </div>
                                <div class="profile-header-detail-row">
                                    <span class="profile-info-label">@Strings.Get("phone")</span>
                                    <span class="profile-info-value">@OtherUserDetail.Phone</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="profile-header-stats">
                        <p><strong>@ProfileSummary.PostCount</strong> @Strings.Get("postsCount")</p>
                        @if (AuthState.CanManageUsers)
                        {
                            @* Admin/Moderator already has a Connections tab for this same data right
                               below — these stay as plain counts instead of routing to the standalone
                               followers/following pages. *@
                            <p><strong>@ProfileSummary.FollowerCount</strong> @Strings.Get("followers")</p>
                            <p><strong>@ProfileSummary.FollowingCount</strong> @Strings.Get("following")</p>
                        }
                        else
                        {
                            <button type="button" class="profile-header-stat-link" @onclick='() => Navigation.NavigateTo($"/profile/{Uri.EscapeDataString(DisplayName)}/followers?id={ProfileSummary.Id}")'>
                                <strong>@ProfileSummary.FollowerCount</strong> @Strings.Get("followers")
                            </button>
                            <button type="button" class="profile-header-stat-link" @onclick='() => Navigation.NavigateTo($"/profile/{Uri.EscapeDataString(DisplayName)}/following?id={ProfileSummary.Id}")'>
                                <strong>@ProfileSummary.FollowingCount</strong> @Strings.Get("following")
                            </button>
                        }
                    </div>
                }
            </div>

            @if (AuthState.CanManageUsers)
            {
                <nav class="profile-nav">
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Posts ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Posts)">@Strings.Get("postsTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Notes ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Notes)">@Strings.Get("notesTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Favorites ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Favorites)">@Strings.Get("favoritesTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Connections ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Connections)">@Strings.Get("connectionsTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Comments ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Comments)">@Strings.Get("commentsTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Likes ? "profile-nav-item-active" : "")" @onclick="() => SelectOtherTab(OtherProfileTab.Likes)">@Strings.Get("likesTab")</button>
                    @if (OtherUserDetail is not null)
                    {
                        <button type="button" class="profile-nav-item profile-nav-item-danger" @onclick="() => DeactivateModalOpen = true">@(IsDeactivated ? Strings.Get("reactivateAccount") : Strings.Get("deactivateAccount"))</button>
                    }
                </nav>

                @if (OtherTab == OtherProfileTab.Posts)
                {
                    @if (OtherPosts.Count == 0)
                    {
                        <p class="stub-text">@Strings.Get("noPostsYet")</p>
                    }
                    else
                    {
                        @foreach (var post in OtherPosts)
                        {
                            <PostCard Post="post" ShowFollowButton="false" OnDeleted="StateHasChanged" />
                        }
                    }
                }
                else if (OtherTab == OtherProfileTab.Notes)
                {
                    @if (OtherAllNotes is null)
                    {
                        <div class="wizard-spinner" aria-hidden="true"></div>
                    }
                    else
                    {
                        @if (OtherGroups is { Count: > 0 })
                        {
                            <div class="notes-actions-row">
                                @foreach (var group in OtherGroups)
                                {
                                    <span class="notes-action-card notes-action-card-group" @key="group.Id">
                                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>
                                        <span>@group.Name</span>
                                    </span>
                                }
                            </div>
                        }

                        @if (OtherAllNotes.Count == 0)
                        {
                            <p class="stub-text">@Strings.Get("noNotesYet")</p>
                        }
                        else
                        {
                            <NotesList Title="" Posts="OtherAllNotes" OnDelete="HandleDeleteOtherNote" />
                        }
                    }
                }
                else if (OtherTab == OtherProfileTab.Connections)
                {
                    @if (OtherFollowers is null)
                    {
                        <div class="wizard-spinner" aria-hidden="true"></div>
                    }
                    else
                    {
                        <div class="connections-split">
                            <div class="connections-column">
                                <h2 class="connections-column-heading">@OtherFollowing!.Count @Strings.Get("following")</h2>
                                @if (OtherFollowing.Count == 0)
                                {
                                    <p class="stub-text">@Strings.Get("noConnectionsYet")</p>
                                }
                                else
                                {
                                    <div class="connections-list">
                                        @foreach (var connection in OtherFollowing)
                                        {
                                            <a class="connection-card" href="@($"/profile/{Uri.EscapeDataString(connection.FullName)}")" @key="connection.Id">
                                                <span class="avatar-circle" aria-hidden="true">@connection.Name.Substring(0, 1)</span>
                                                <div class="connection-info">
                                                    <p class="connection-name">@connection.FullName</p>
                                                    <p class="connection-role">@connection.JobTitle</p>
                                                </div>
                                                <span class="connection-arrow" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="7" y1="17" x2="17" y2="7" />
                                                        <polyline points="7 7 17 7 17 17" />
                                                    </svg>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="connections-divider" aria-hidden="true"></div>

                            <div class="connections-column">
                                <h2 class="connections-column-heading">@OtherFollowers.Count @Strings.Get("followers")</h2>
                                @if (OtherFollowers.Count == 0)
                                {
                                    <p class="stub-text">@Strings.Get("noFollowersYet")</p>
                                }
                                else
                                {
                                    <div class="connections-list">
                                        @foreach (var connection in OtherFollowers)
                                        {
                                            <a class="connection-card" href="@($"/profile/{Uri.EscapeDataString(connection.FullName)}")" @key="connection.Id">
                                                <span class="avatar-circle" aria-hidden="true">@connection.Name.Substring(0, 1)</span>
                                                <div class="connection-info">
                                                    <p class="connection-name">@connection.FullName</p>
                                                    <p class="connection-role">@connection.JobTitle</p>
                                                </div>
                                                <span class="connection-arrow" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="7" y1="17" x2="17" y2="7" />
                                                        <polyline points="7 7 17 7 17 17" />
                                                    </svg>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else if (OtherTab == OtherProfileTab.Favorites)
                {
                    @if (OtherFavorites.Count == 0)
                    {
                        <p class="stub-text">@Strings.Get("noFavoritesYet")</p>
                    }
                    else
                    {
                        @foreach (var post in OtherFavorites)
                        {
                            <PostCard Post="post" ShowFollowButton="false" OnDeleted="StateHasChanged" />
                        }
                    }
                }
                else if (OtherTab == OtherProfileTab.Likes)
                {
                    @if (OtherLikes.Count == 0)
                    {
                        <p class="stub-text">@Strings.Get("noLikesYet")</p>
                    }
                    else
                    {
                        @foreach (var post in OtherLikes)
                        {
                            <PostCard Post="post" ShowFollowButton="false" OnDeleted="StateHasChanged" />
                        }
                    }
                }
                else if (OtherTab == OtherProfileTab.Comments)
                {
                    @if (OtherComments.Count == 0)
                    {
                        <p class="stub-text">@Strings.Get("noCommentsYet")</p>
                    }
                    else
                    {
                        @foreach (var (post, comment) in OtherComments)
                        {
                            <div class="profile-comment-entry">
                                <PostCard Post="post" ShowFollowButton="false" OnDeleted="StateHasChanged" />
                                <div class="post-comment">
                                    <span class="avatar-circle" aria-hidden="true">@comment.AuthorName.Substring(0, 1)</span>
                                    <div class="post-comment-body">
                                        <p>@comment.Text</p>
                                    </div>
                                    <button type="button" class="post-action-icon post-delete-icon post-comment-delete-icon" title="@Strings.Get("delete")" @onclick="() => DeleteComment(post, comment)">
                                        @TrashIcon
                                    </button>
                                </div>
                            </div>
                        }
                    }
                }
            }
            else
            {
                <nav class="profile-nav">
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Posts ? "profile-nav-item-active" : "")" @onclick="() => OtherTab = OtherProfileTab.Posts">@Strings.Get("postsTab")</button>
                    <button type="button" class="profile-nav-item @(OtherTab == OtherProfileTab.Reposts ? "profile-nav-item-active" : "")" @onclick="SelectRepostsTab">@Strings.Get("repostsTab")</button>
                    @if (ProfileSummary is not null)
                    {
                        <button type="button" class="profile-nav-item @(ProfileSummary.FollowedByMe ? "profile-nav-item-active" : "")" @onclick="ToggleFollowOnProfile">
                            @(ProfileSummary.FollowedByMe ? Strings.Get("following") : Strings.Get("follow"))
                        </button>
                    }
                </nav>

                @if (OtherTab == OtherProfileTab.Reposts)
                {
                    @if (Reposts is null)
                    {
                        <p class="stub-text">@Strings.Get("loading")</p>
                    }
                    else if (Reposts.Count == 0)
                    {
                        <p class="stub-text">@Strings.Get("noPostsYet")</p>
                    }
                    else
                    {
                        @foreach (var post in Reposts)
                        {
                            <PostCard Post="post" />
                        }
                    }
                }
                else if (OtherPosts.Count == 0)
                {
                    <p class="stub-text">@Strings.Get("noPostsYet")</p>
                }
                else
                {
                    @foreach (var post in OtherPosts)
                    {
                        <PostCard Post="post" />
                    }
                }
            }
        }
    </div>
</div>

@if (IsOwnProfile)
{
    <TourGuide TourId="profile" />
}

@if (AuthState.CanManageUsers && !IsOwnProfile && OtherUserDetail is not null && OtherUserId is int otherUserId)
{
    <DeactivateAccountModal IsOpen="DeactivateModalOpen" IsOpenChanged="@(open => DeactivateModalOpen = open)"
        UserId="otherUserId" UserName="@DisplayName" UserEmail="@OtherUserDetail.Email"
        IsCurrentlyDeactivated="IsDeactivated" OnChanged="RefreshOtherUserDetail" />
}

<Modal IsOpen="RoleChangeModalOpen" IsOpenChanged="@(open => RoleChangeModalOpen = open)" ShowAcceptButton="false">
    <h3 class="modal-form-heading">@Strings.Get("requestRoleChangeHeading")</h3>
    <p class="stub-text">@Strings.Get("requestRoleChangeBody") <strong>@RoleChangeTarget</strong>?</p>
    <div class="modal-confirm-actions">
        <button type="button" class="btn-secondary" @onclick="() => RoleChangeModalOpen = false">@Strings.Get("cancel")</button>
        <button type="button" class="btn-primary" @onclick="ConfirmRoleChangeRequest">@Strings.Get("yes")</button>
    </div>
</Modal>

@code {
    private enum ProfileTab { Profile, MyPosts, MyFavorites, MyReposts, MyNotes, Settings }
    private enum OtherProfileTab { Posts, Reposts, Notes, Favorites, Connections, Comments, Likes }

    [Parameter] public string? AuthorName { get; set; }

    // Compares against the real logged-in identity (hydrated from auth into Store.Profile),
    // not NotesStore.CurrentUserName — that's a mock-data constant that only ever means
    // "Aslı Koturoğlu" and would misidentify every other logged-in account's own profile.
    private bool IsOwnProfile => string.IsNullOrWhiteSpace(AuthorName) || AuthorName == Store.Profile.FullName;

    private string DisplayName => IsOwnProfile ? Store.Profile.FullName : AuthorName!;

    // Role-change request (own profile only) — see requestRoleChange row below the Password
    // field. PendingRoleRequest disables the icon while one's already awaiting a decision.
    private string CurrentRole => AuthState.CurrentUser?.Role ?? "User";
    private string RoleChangeTarget => CurrentRole == "Moderator" ? "User" : "Moderator";
    private bool RoleChangeModalOpen;
    private UserRequestDto? PendingRoleRequest;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentRole != "Admin")
            PendingRoleRequest = (await RequestsApi.GetMineAsync())
                .FirstOrDefault(r => r.RequestedRole is not null && r.Decision == "Pending");
    }

    private void OpenRoleChangeModal() => RoleChangeModalOpen = true;

    private async Task ConfirmRoleChangeRequest()
    {
        PendingRoleRequest = await RequestsApi.CreateRoleChangeAsync();
        RoleChangeModalOpen = false;
    }

    private List<Post> OtherPosts => Store.GetPostsByAuthor(DisplayName);
    private List<Post> OtherFavorites => Store.GetFavoritesByAuthor(DisplayName);
    private List<Post> OtherLikes => Store.GetLikesByAuthor(DisplayName);
    private List<(Post Post, PostComment Comment)> OtherComments => Store.GetCommentsByAuthor(DisplayName);

    private string DisplayRole => OtherPosts.Count > 0 ? OtherPosts[0].AuthorRole : "";

    // Email/Phone/JobTitle aren't carried on Post (only AuthorName/AuthorRole are), so the
    // richer admin-only info row needs a real lookup — keyed off any of this author's posts
    // for their AuthorId, since routing here only ever gives us a display name.
    private UserDto? OtherUserDetail { get; set; }
    private string? OtherUserDetailLoadedFor { get; set; }
    private int? OtherUserId => OtherPosts.FirstOrDefault()?.AuthorId;

    // Public header (avatar/username/job title/joined date/post/follower/following counts) for
    // any signed-in viewer — separate from OtherUserDetail above, which is the admin-only
    // email/phone lookup.
    private ProfileSummaryDto? ProfileSummary { get; set; }
    private string? ProfileSummaryLoadedFor { get; set; }
    private List<Post>? Reposts { get; set; }

    // Admin-only, lazy-loaded the first time their tab is opened (see SelectOtherTab) — the
    // target's full note collection (shared and unshared, mirroring their own All Notes page)
    // plus the groups they've organized them into, and their followers/following lists.
    private List<Post>? OtherAllNotes { get; set; }
    private List<GroupDto>? OtherGroups { get; set; }
    private List<ConnectionDto>? OtherFollowers { get; set; }
    private List<ConnectionDto>? OtherFollowing { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOwnProfile && ProfileSummaryLoadedFor != DisplayName)
        {
            ProfileSummaryLoadedFor = DisplayName;
            Reposts = null;
            OtherAllNotes = null;
            OtherGroups = null;
            OtherFollowers = null;
            OtherFollowing = null;
            OtherTab = OtherProfileTab.Posts;
            // Display name isn't unique (two accounts can share one) — go by id whenever one of
            // this author's posts has already given us their real id, only falling back to the
            // ambiguous name lookup when nothing's loaded yet (e.g. they have zero shared posts).
            ProfileSummary = OtherUserId is int summaryId
                ? await ProfileApi.GetSummaryByIdAsync(summaryId)
                : await ProfileApi.GetSummaryAsync(DisplayName);
        }

        if (!AuthState.CanManageUsers || IsOwnProfile)
            return;

        if (OtherUserDetailLoadedFor == DisplayName)
            return;

        OtherUserDetailLoadedFor = DisplayName;
        await RefreshOtherUserDetail();
    }

    private async Task RefreshOtherUserDetail()
    {
        OtherUserDetail = OtherUserId is int id ? await UsersApi.GetByIdAsync(id) : null;
    }

    private async Task SelectRepostsTab()
    {
        OtherTab = OtherProfileTab.Reposts;
        Reposts ??= OtherUserId is int id
            ? await Store.GetRepostsByAuthorIdAsync(id)
            : await Store.GetRepostsByAuthorAsync(DisplayName);
    }

    // Admin's own-user-view nav: loads each tab's data on first visit only, keyed off
    // ProfileSummary.Id (reliable even for a target with zero shared posts, unlike OtherUserId).
    private async Task SelectOtherTab(OtherProfileTab tab)
    {
        OtherTab = tab;
        if (ProfileSummary is not { } summary)
            return;

        if (tab == OtherProfileTab.Notes && OtherAllNotes is null)
        {
            OtherAllNotes = await Store.GetNotesByAuthorIdAsync(summary.Id);
            OtherGroups = await Store.GetGroupsByAuthorIdAsync(summary.Id);
        }
        else if (tab == OtherProfileTab.Connections && OtherFollowers is null)
        {
            OtherFollowers = await ProfileApi.GetFollowersByIdAsync(summary.Id);
            OtherFollowing = await ProfileApi.GetFollowingByIdAsync(summary.Id);
        }
    }

    private async Task ToggleFollowOnProfile()
    {
        if (ProfileSummary is null)
            return;

        var following = await Store.ToggleFollowByUserIdAsync(ProfileSummary.Id);
        if (following is null)
            return;

        ProfileSummary.FollowedByMe = following.Value;
        ProfileSummary.FollowerCount += following.Value ? 1 : -1;
    }

    private ProfileTab ActiveTab { get; set; } = ProfileTab.Profile;
    private OtherProfileTab OtherTab { get; set; } = OtherProfileTab.Posts;

    private bool DeactivateModalOpen { get; set; }
    private bool IsDeactivated => OtherUserDetail?.IsDeactivated ?? false;

    private static readonly RenderFragment TrashIcon = @<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>;

    private bool EditingName { get; set; }
    private string NameDraft { get; set; } = "";
    private string SurnameDraft { get; set; } = "";
    private bool IsNameValid => !string.IsNullOrWhiteSpace(NameDraft) && !string.IsNullOrWhiteSpace(SurnameDraft);

    private string? EditingField { get; set; }
    private string FieldDraft { get; set; } = "";

    private static readonly RenderFragment PencilIcon = @<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>;

    private RenderFragment FieldActions(string field) => @<div class="field-action-row">
        <button type="button" class="field-confirm-icon" disabled="@(!IsFieldValid(field, FieldDraft))" @onclick="@(() => CommitField(field))" aria-label="Save">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
        </button>
        <button type="button" class="field-cancel-icon" @onclick="CancelEdit" aria-label="Cancel">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
        </button>
    </div>;

    private void StartEditName()
    {
        NameDraft = Store.Profile.Name;
        SurnameDraft = Store.Profile.Surname;
        EditingName = true;
        EditingField = null;
    }

    private void SaveName()
    {
        if (!IsNameValid)
            return;

        Store.Profile.Name = NameDraft.Trim();
        Store.Profile.Surname = SurnameDraft.Trim();
        EditingName = false;
    }

    private void StartEditField(string field, string currentValue)
    {
        EditingField = field;
        FieldDraft = currentValue;
        EditingName = false;
    }

    private void CommitField(string field)
    {
        if (EditingField != field || !IsFieldValid(field, FieldDraft))
            return;

        switch (field)
        {
            case "phone": Store.Profile.Phone = FieldDraft.Trim(); break;
            case "jobTitle": Store.Profile.JobTitle = FieldDraft.Trim(); break;
            case "username": Store.Profile.Username = FieldDraft.Trim(); break;
            case "password": Store.Profile.Password = FieldDraft; break;
        }

        EditingField = null;
    }

    private void CancelEdit()
    {
        EditingName = false;
        EditingField = null;
    }

    private static bool IsFieldValid(string field, string value) => field switch
    {
        "phone" => SignupValidation.IsValidPhoneFormat(value),
        "jobTitle" => !string.IsNullOrWhiteSpace(value),
        "username" => Regex.IsMatch(value.Trim(), @"^[A-Za-z0-9_.]{3,}$"),
        "password" => SignupValidation.GetPasswordRequirements(value).All(r => r.Satisfied),
        _ => false,
    };

    private async Task HandleLogout()
    {
        await AuthState.ClearSessionAsync();
        Navigation.NavigateTo("/");
    }

    private async Task DeleteComment(Post post, PostComment comment) => await Store.DeleteCommentAsync(post, comment);

    private async Task HandleDeleteOtherNote(Post post) => await Store.DeletePostAsync(post);
}
