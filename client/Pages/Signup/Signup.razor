@page "/signup"
@using Client.Pages.Home
@using Client.Services
@inject NavigationManager Navigation
@inject UiStrings Strings
@inject AuthApiClient AuthApi
@inject AuthState AuthState
@inject NotesStore Store

<PageTitle>@Strings.Get("register")</PageTitle>

<div class="auth-page">
    <h1 class="brand-title">synapse.</h1>

    <div class="auth-card">
        <EditForm Model="this" OnValidSubmit="AttemptSubmit">
            <div class="form-group">
                <label class="form-label" for="signup-name">@Strings.Get("name")</label>
                <InputText id="signup-name" class="@FieldClass(string.IsNullOrWhiteSpace(Name), true)" placeholder="@Strings.Get("namePlaceholder")"
                           @bind-Value="Name" @onfocusout="() => NameTouched = true" />
                @if (NameTouched && string.IsNullOrWhiteSpace(Name))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="signup-surname">@Strings.Get("surname")</label>
                <InputText id="signup-surname" class="@FieldClass(string.IsNullOrWhiteSpace(Surname), true)" placeholder="@Strings.Get("surnamePlaceholder")"
                           @bind-Value="Surname" @onfocusout="() => SurnameTouched = true" />
                @if (SurnameTouched && string.IsNullOrWhiteSpace(Surname))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="signup-username">@Strings.Get("username")</label>
                <InputText id="signup-username" class="@FieldClass(string.IsNullOrWhiteSpace(Username), true)" placeholder="@Strings.Get("usernamePlaceholder")"
                           @bind-Value="Username" @onfocusout="() => UsernameTouched = true" />
                @if (UsernameTouched && string.IsNullOrWhiteSpace(Username))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="signup-email">@Strings.Get("emailAddress")</label>
                <InputText id="signup-email" class="@FieldClass(string.IsNullOrWhiteSpace(Email), EmailFormatValid)" placeholder="@Strings.Get("emailPlaceholder")"
                           @bind-Value="Email" @bind-Value:after="ValidateEmail" @onfocusout="() => EmailTouched = true" />
                @if (EmailTouched && string.IsNullOrWhiteSpace(Email))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
                else if (EmailTouched && !EmailFormatValid)
                {
                    <p class="field-error">@Strings.Get("emailMustContainAt")</p>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="signup-password">@Strings.Get("password")</label>
                <PasswordInput Id="signup-password" Placeholder="@Strings.Get("passwordPlaceholder")"
                               CssClass="@FieldClass(string.IsNullOrEmpty(Password), PasswordRequirementsMet)"
                               Value="@Password" ValueChanged="OnPasswordChanged" OnBlur="() => PasswordTouched = true" />
                @if (PasswordTouched && string.IsNullOrEmpty(Password))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
                else if (PasswordTouched && !PasswordRequirementsMet)
                {
                    <ul class="requirement-list">
                        @foreach (var req in PasswordRequirements)
                        {
                            <li class="@(req.Satisfied ? "requirement-met" : "requirement-unmet")">@req.Description</li>
                        }
                    </ul>
                }
            </div>

            <div class="form-group">
                <label class="form-label" for="signup-confirm-password">@Strings.Get("reEnterPassword")</label>
                <PasswordInput Id="signup-confirm-password" Placeholder="@Strings.Get("reEnterPasswordPlaceholder")"
                               CssClass="@FieldClass(string.IsNullOrEmpty(ConfirmPassword), PasswordsMatch)"
                               Value="@ConfirmPassword" ValueChanged="OnConfirmPasswordChanged" OnBlur="() => ConfirmPasswordTouched = true" />
                @if (ConfirmPasswordTouched && string.IsNullOrEmpty(ConfirmPassword))
                {
                    <p class="field-error">@Strings.Get("fieldRequired")</p>
                }
                else if (ConfirmPasswordTouched && !PasswordsMatch)
                {
                    <p class="field-error">@Strings.Get("passwordsDoNotMatch")</p>
                }
            </div>

            <div class="checkbox-row">
                <InputCheckbox id="signup-agree" @bind-Value="AgreeToTerms" disabled="@(!(TermsAccepted && PrivacyAccepted))" />
                <div>
                    <label class="checkbox-label" for="signup-agree">@Strings.Get("agreeToTerms")</label>
                    <ul class="terms-list">
                        <li>
                            <button type="button" class="link-inline" @onclick="() => TermsModalOpen = true">@Strings.Get("termsOfService")</button>
                            @if (TermsAccepted)
                            {
                                <span class="check-mark">✓</span>
                            }
                        </li>
                        <li>
                            <button type="button" class="link-inline" @onclick="() => PrivacyModalOpen = true">@Strings.Get("privacyPolicy")</button>
                            @if (PrivacyAccepted)
                            {
                                <span class="check-mark">✓</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="field-error">@ErrorMessage</p>
            }

            <button type="submit" class="btn-primary btn-block @(CanSubmit && !IsSubmitting ? "" : "btn-disabled-look")" disabled="@IsSubmitting">@Strings.Get("register")</button>
        </EditForm>
    </div>

    <BackLink />
</div>

<Modal IsOpen="TermsModalOpen" IsOpenChanged="@(open => TermsModalOpen = open)" OnAccept="@(() => TermsAccepted = true)">
    <TermsOfServiceContent />
</Modal>

<Modal IsOpen="PrivacyModalOpen" IsOpenChanged="@(open => PrivacyModalOpen = open)" OnAccept="@(() => PrivacyAccepted = true)">
    <PrivacyPolicyContent />
</Modal>

@code {
    private string Name { get; set; } = "";
    private string Surname { get; set; } = "";
    private string Username { get; set; } = "";
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private bool AgreeToTerms { get; set; }

    private bool TermsModalOpen { get; set; }
    private bool PrivacyModalOpen { get; set; }
    private bool TermsAccepted { get; set; }
    private bool PrivacyAccepted { get; set; }

    private bool NameTouched { get; set; }
    private bool SurnameTouched { get; set; }
    private bool UsernameTouched { get; set; }
    private bool EmailTouched { get; set; }
    private bool PasswordTouched { get; set; }
    private bool ConfirmPasswordTouched { get; set; }

    private bool EmailFormatValid { get; set; } = true;
    private bool PasswordsMatch { get; set; } = true;
    private IReadOnlyList<(string Description, bool Satisfied)> PasswordRequirements { get; set; } =
        SignupValidation.GetPasswordRequirements("");

    private string? ErrorMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private bool PasswordRequirementsMet => PasswordRequirements.All(r => r.Satisfied);

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(Name) &&
        !string.IsNullOrWhiteSpace(Surname) &&
        !string.IsNullOrWhiteSpace(Username) &&
        !string.IsNullOrWhiteSpace(Email) && EmailFormatValid &&
        !string.IsNullOrEmpty(Password) && PasswordRequirementsMet &&
        !string.IsNullOrEmpty(ConfirmPassword) && PasswordsMatch &&
        AgreeToTerms;

    private static string FieldClass(bool isEmpty, bool isValid) =>
        "form-input " + (isEmpty ? "" : isValid ? "field-valid" : "field-invalid");

    private void ValidateEmail()
    {
        EmailFormatValid = SignupValidation.IsValidEmailFormat(Email);
    }

    private void OnPasswordChanged(string value)
    {
        Password = value;
        PasswordTouched = true;
        PasswordRequirements = SignupValidation.GetPasswordRequirements(Password);
        ValidatePasswordsMatch();
    }

    private void OnConfirmPasswordChanged(string value)
    {
        ConfirmPassword = value;
        ConfirmPasswordTouched = true;
        ValidatePasswordsMatch();
    }

    private void ValidatePasswordsMatch()
    {
        PasswordsMatch = ConfirmPassword.Length == 0 || Password == ConfirmPassword;
    }

    private async Task AttemptSubmit()
    {
        if (CanSubmit)
        {
            await HandleSignup();
            return;
        }

        NameTouched = true;
        SurnameTouched = true;
        UsernameTouched = true;
        EmailTouched = true;
        PasswordTouched = true;
        ConfirmPasswordTouched = true;
        ValidateEmail();
        PasswordRequirements = SignupValidation.GetPasswordRequirements(Password);
        ValidatePasswordsMatch();
    }

    private async Task HandleSignup()
    {
        ErrorMessage = null;
        IsSubmitting = true;

        var result = await AuthApi.SignupAsync(new SignupRequest
        {
            Name = Name.Trim(),
            Surname = Surname.Trim(),
            Username = Username.Trim(),
            Email = Email.Trim(),
            Password = Password,
        });

        IsSubmitting = false;

        if (!result.Succeeded || result.Response is null)
        {
            ErrorMessage = result.Error ?? "Something went wrong. Please try again.";
            return;
        }

        await AuthState.SetSessionAsync(result.Response);
        ApplyProfile(result.Response.User);

        Navigation.NavigateTo("/home");
    }

    private void ApplyProfile(UserDto user)
    {
        Store.Profile.Name = user.Name;
        Store.Profile.Surname = user.Surname;
        Store.Profile.Username = user.Username;
        Store.Profile.Email = user.Email;
        Store.Profile.Phone = user.Phone;
        Store.Profile.JobTitle = user.JobTitle;
    }
}
