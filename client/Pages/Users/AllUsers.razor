@page "/users"
@using Client.Pages.Home
@using Client.Services
@inject NotesStore Store
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject UiStrings Strings
@inject UsersApiClient UsersApi

<PageTitle>@Strings.Get("allUsers")</PageTitle>

<PrimaryHeader />

<div class="home-body">
    <Drawer UserName="@Store.Profile.Name" UserEmail="@Store.Profile.Email" />

    <div class="home-feed">
        <h1 class="notes-title">@Strings.Get("allUsers")</h1>

        @if (Users is null)
        {
            <p class="stub-text">@Strings.Get("loading")</p>
        }
        else if (Users.Count == 0)
        {
            <p class="stub-text">@Strings.Get("noUsersYet")</p>
        }
        else
        {
            <div class="users-filters-row">
                <input class="form-input users-search-input" placeholder="@Strings.Get("searchUsersPlaceholder")" @bind="SearchTerm" @bind:event="oninput" />

                <select class="users-filter-select" @bind="JobTitleFilter">
                    <option value="">@Strings.Get("allJobTitles")</option>
                    @foreach (var jobTitle in JobTitleOptions)
                    {
                        <option value="@jobTitle">@jobTitle</option>
                    }
                </select>

                <select class="users-filter-select" @bind="RoleFilter">
                    <option value="">@Strings.Get("allRoles")</option>
                    <option value="User">@Strings.Get("user")</option>
                    <option value="Moderator">Moderator</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            @if (SelectedIds.Count > 0)
            {
                <div class="users-bulk-bar">
                    <span class="users-bulk-count">@SelectedIds.Count @Strings.Get("selected")</span>
                    <button type="button" class="btn-secondary" @onclick="ViewSelectedRequests">@Strings.Get("viewRequests")</button>
                    <button type="button" class="btn-secondary" @onclick="() => BulkDeactivateModalOpen = true">@Strings.Get("deactivateAccount")</button>
                    <button type="button" class="btn-danger" @onclick="() => BulkDeleteModalOpen = true">@Strings.Get("deleteAccount")</button>
                    <button type="button" class="link-inline" @onclick="ClearSelection">@Strings.Get("clearSelection")</button>
                </div>
            }

            @if (FilteredUsers.Count == 0)
            {
                <p class="stub-text">@Strings.Get("noUsersYet")</p>
            }
            else
            {
                <div class="users-table-wrap">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th><input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" aria-label="Select all" /></th>
                                <th>@Strings.Get("user")</th>
                                <th>@Strings.Get("role")</th>
                                <th>@Strings.Get("mail")</th>
                                <th>@Strings.Get("phoneNumber")</th>
                                <th>@Strings.Get("accountCreated")</th>
                                <th>@Strings.Get("passwordChanged")</th>
                                <th>@Strings.Get("jobTitle")</th>
                                <th>@Strings.Get("tokenUsage")</th>
                                <th>@Strings.Get("actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in FilteredUsers)
                            {
                                <tr class="@(user.IsDeactivated ? "users-table-row-deactivated" : "")" @key="user.Id">
                                    <td><input type="checkbox" checked="@SelectedIds.Contains(user.Id)" @onchange="() => ToggleSelect(user.Id)" aria-label="@($"Select {user.FullName}")" /></td>
                                    <td>
                                        <div class="users-table-user">
                                            <span class="avatar-circle" aria-hidden="true">@user.Name.Substring(0, 1)</span>
                                            <div>
                                                <p class="users-table-name">@user.FullName</p>
                                                <p class="users-table-username">@user.Username</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (AuthState.IsAdmin && user.Role != "Admin")
                                        {
                                            <button type="button" class="users-table-role-badge @RoleBadgeClass(user.Role)" @onclick="() => OpenToggleRole(user)">@user.Role</button>
                                        }
                                        else
                                        {
                                            @* Admin's own role is protected (can't be changed here at all), and a
                                               Moderator viewer can't grant/revoke Moderator status on anyone —
                                               both render as a plain, non-interactive badge instead of a button. *@
                                            <span class="users-table-role-badge @RoleBadgeClass(user.Role)">@user.Role</span>
                                        }
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@user.Phone</td>
                                    <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>@(user.PasswordChangedAt is { } changed ? changed.ToLocalTime().ToString("dd/MM/yyyy") : "—")</td>
                                    <td>@user.JobTitle</td>
                                    <td>@user.TokenUsage</td>
                                    <td>
                                        <div class="users-table-actions">
                                            <a class="users-table-action users-table-action-go" aria-label="@Strings.Get("goToProfile")" data-tooltip="@Strings.Get("goToProfile")" href="@($"/profile/{Uri.EscapeDataString(user.FullName)}")">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" /></svg>
                                            </a>
                                            <a class="users-table-action users-table-action-go" aria-label="@Strings.Get("viewRequests")" data-tooltip="@Strings.Get("viewRequests")" href="@($"/requests?userIds={user.Id}")">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22 6 12 13 2 6" /></svg>
                                            </a>
                                            <button type="button" class="users-table-action users-table-action-warn" aria-label="@Strings.Get("getNewPassword")" data-tooltip="@Strings.Get("getNewPassword")" @onclick="() => OpenResetPassword(user)">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                            </button>
                                            <button type="button" class="users-table-action users-table-action-warn" aria-label="@(user.IsDeactivated ? Strings.Get("reactivateAccount") : Strings.Get("deactivateAccount"))" data-tooltip="@(user.IsDeactivated ? Strings.Get("reactivateAccount") : Strings.Get("deactivateAccount"))" @onclick="() => OpenDeactivate(user)">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" /><line x1="4" y1="22" x2="4" y2="15" /></svg>
                                            </button>
                                            <button type="button" class="users-table-action users-table-action-danger" aria-label="@Strings.Get("deleteAccount")" data-tooltip="@Strings.Get("deleteAccount")" @onclick="() => OpenDelete(user)">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@if (SelectedUser is not null)
{
    <DeactivateAccountModal IsOpen="DeactivateModalOpen" IsOpenChanged="@(open => DeactivateModalOpen = open)"
        UserId="SelectedUser.Id" UserName="@SelectedUser.FullName" UserEmail="@SelectedUser.Email"
        IsCurrentlyDeactivated="SelectedUser.IsDeactivated" OnChanged="ReloadUsers" />

    <Modal IsOpen="DeleteModalOpen" IsOpenChanged="@(open => DeleteModalOpen = open)" OnAccept="ConfirmDelete" AcceptLabel="@Strings.Get("deleteAccount")" AcceptButtonClass="btn-danger">
        <h3 class="modal-form-heading">@Strings.Get("deleteAccount")</h3>
        <p class="stub-text">@Strings.Get("adminDeleteAccountConfirm") <strong>@SelectedUser.FullName</strong></p>
    </Modal>

    <Modal IsOpen="ResetPasswordModalOpen" IsOpenChanged="@(open => ResetPasswordModalOpen = open)" ShowAcceptButton="false">
        <h3 class="modal-form-heading">@Strings.Get("getNewPassword")</h3>
        @if (GeneratedPassword is null)
        {
            <p class="stub-text">@Strings.Get("generatingPassword")</p>
        }
        else
        {
            <p class="stub-text">@Strings.Get("passwordGeneratedNote") <strong>@SelectedUser.Email</strong>:</p>
            <p class="users-generated-password">@GeneratedPassword</p>
        }
    </Modal>

    <Modal IsOpen="RoleModalOpen" IsOpenChanged="@(open => RoleModalOpen = open)" ShowAcceptButton="false">
        <h3 class="modal-form-heading">@Strings.Get("changeRole")</h3>
        <p class="stub-text">Are you sure you want to change <strong>@SelectedUser.FullName</strong>'s role from <strong>@SelectedUser.Role</strong> to <strong>@OtherRole(SelectedUser.Role)</strong>?</p>
        @if (RoleChangeError is not null)
        {
            <p class="field-error">@RoleChangeError</p>
        }
        <button type="button" class="btn-primary btn-block" @onclick="ConfirmToggleRole">@Strings.Get("accept")</button>
    </Modal>
}

<Modal IsOpen="BulkDeactivateModalOpen" IsOpenChanged="@(open => BulkDeactivateModalOpen = open)" ShowAcceptButton="false">
    <h3 class="modal-form-heading">@Strings.Get("deactivateAccount") (@SelectedIds.Count)</h3>
    <div class="deactivate-reason-list">
        @foreach (var reason in DeactivateReasons)
        {
            <label class="deactivate-reason-option">
                <input type="radio" name="bulk-deactivate-reason" checked="@(BulkReason == reason)" @onchange="() => BulkReason = reason" />
                <span>@reason</span>
            </label>
        }
    </div>
    <button type="button" class="btn-danger btn-block" disabled="@(BulkReason is null)" @onclick="ConfirmBulkDeactivate">@Strings.Get("deactivateAccount")</button>
</Modal>

<Modal IsOpen="BulkDeleteModalOpen" IsOpenChanged="@(open => BulkDeleteModalOpen = open)" OnAccept="ConfirmBulkDelete" AcceptLabel="@Strings.Get("deleteAccount")" AcceptButtonClass="btn-danger">
    <h3 class="modal-form-heading">@Strings.Get("deleteAccount")</h3>
    <p class="stub-text">@Strings.Get("bulkDeleteConfirm") <strong>@SelectedIds.Count</strong></p>
</Modal>

@code {
    private static readonly string[] DeactivateReasons =
    [
        "Harmful Posts",
        "Disrespectful to other users",
        "Spam or Fake Content",
        "Policy Violation",
        "Inactive Account",
    ];

    private List<AdminUserDto>? Users;
    private AdminUserDto? SelectedUser;
    private bool DeactivateModalOpen;
    private bool DeleteModalOpen;
    private bool ResetPasswordModalOpen;
    private string? GeneratedPassword;
    private bool RoleModalOpen;
    private string? RoleChangeError;

    private string SearchTerm = "";
    private string JobTitleFilter = "";
    private string RoleFilter = "";
    private readonly HashSet<int> SelectedIds = [];
    private bool BulkDeactivateModalOpen;
    private bool BulkDeleteModalOpen;
    private string? BulkReason;

    // This toggle only ever moves a user between User and Moderator — Admin is a protected,
    // separate status not changeable through this button (see UserService.ToggleRoleAsync).
    private static string OtherRole(string role) => role == "Moderator" ? "User" : "Moderator";

    private static string RoleBadgeClass(string role) => role switch
    {
        "Admin" => "users-table-role-badge-admin",
        "Moderator" => "users-table-role-badge-moderator",
        _ => "",
    };

    private List<string> JobTitleOptions => (Users ?? [])
        .Select(u => u.JobTitle)
        .Where(j => !string.IsNullOrWhiteSpace(j))
        .Distinct()
        .OrderBy(j => j)
        .ToList();

    private List<AdminUserDto> FilteredUsers => (Users ?? [])
        .Where(u => string.IsNullOrWhiteSpace(SearchTerm) ||
                    u.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.Username.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(u => string.IsNullOrEmpty(JobTitleFilter) || u.JobTitle == JobTitleFilter)
        .Where(u => string.IsNullOrEmpty(RoleFilter) || u.Role == RoleFilter)
        .ToList();

    private bool AllVisibleSelected => FilteredUsers.Count > 0 && FilteredUsers.All(u => SelectedIds.Contains(u.Id));

    protected override async Task OnInitializedAsync() => await ReloadUsers();

    private async Task ReloadUsers() => Users = await UsersApi.GetAllAsync();

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        foreach (var user in FilteredUsers)
        {
            if (check)
                SelectedIds.Add(user.Id);
            else
                SelectedIds.Remove(user.Id);
        }
    }

    private void ToggleSelect(int id)
    {
        if (!SelectedIds.Remove(id))
            SelectedIds.Add(id);
    }

    private void ClearSelection() => SelectedIds.Clear();

    private void ViewSelectedRequests() => Navigation.NavigateTo($"/requests?userIds={string.Join(",", SelectedIds)}");

    private void OpenDeactivate(AdminUserDto user)
    {
        SelectedUser = user;
        DeactivateModalOpen = true;
    }

    private void OpenDelete(AdminUserDto user)
    {
        SelectedUser = user;
        DeleteModalOpen = true;
    }

    private async Task ConfirmDelete()
    {
        if (SelectedUser is null)
            return;

        await UsersApi.DeleteAsync(SelectedUser.Id);
        await ReloadUsers();
    }

    private async Task OpenResetPassword(AdminUserDto user)
    {
        SelectedUser = user;
        GeneratedPassword = null;
        ResetPasswordModalOpen = true;
        GeneratedPassword = await UsersApi.ResetPasswordAsync(user.Id);
    }

    private void OpenToggleRole(AdminUserDto user)
    {
        SelectedUser = user;
        RoleChangeError = null;
        RoleModalOpen = true;
    }

    private async Task ConfirmToggleRole()
    {
        if (SelectedUser is null)
            return;

        var (success, error) = await UsersApi.ToggleRoleAsync(SelectedUser.Id);
        if (success)
        {
            RoleModalOpen = false;
            await ReloadUsers();
        }
        else
        {
            RoleChangeError = error ?? "Something went wrong.";
        }
    }

    private async Task ConfirmBulkDeactivate()
    {
        if (BulkReason is null)
            return;

        foreach (var id in SelectedIds.ToList())
            await UsersApi.DeactivateAsync(id, BulkReason);

        BulkDeactivateModalOpen = false;
        BulkReason = null;
        SelectedIds.Clear();
        await ReloadUsers();
    }

    private async Task ConfirmBulkDelete()
    {
        foreach (var id in SelectedIds.ToList())
            await UsersApi.DeleteAsync(id);

        SelectedIds.Clear();
        await ReloadUsers();
    }
}
