@page "/"
@inject UiStrings Strings

<PageTitle>synapse.</PageTitle>

<div class="welcome-bg">
    <div class="welcome-content">
        <p class="eyebrow">@Strings.Get("welcomeEyebrow")</p>
        <h1 class="hero-title">@Strings.Get("welcomeHeroTitle")</h1>
        <p class="tagline">@Strings.Get("welcomeTagline")</p>
        <p class="description">@Strings.Get("welcomeDescription")</p>
        <div class="button-row">
            <a href="/login" class="btn-primary">@Strings.Get("logIn")</a>
            <a href="/signup" class="btn-secondary">@Strings.Get("signUp")</a>
        </div>
    </div>
</div>
